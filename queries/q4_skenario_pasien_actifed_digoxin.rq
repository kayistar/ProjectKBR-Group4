PREFIX kbr: <http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

# Kasus uji sintetis tersimpan sebagai individu di dalam OWL.
SELECT DISTINCT
  ?kasus
  ?namaKasus
  ?namaProduk
  ?obatRutin
  ?zatProduk
  ?statusData
  ?tingkatBahaya
  ?tindakLanjut
  ?penjelasan
  ?tingkatBukti
WHERE {
  ?kasus a kbr:KasusPasien ;
         rdfs:label ?namaKasus ;
         kbr:memilikiObatPasien ?penggunaanProduk, ?penggunaanZatAktif .

  ?penggunaanProduk kbr:menggunakanProdukObat ?produk .
  ?penggunaanZatAktif kbr:menggunakanZatAktif ?zatRutin .

  ?produk a kbr:ProduktObat ;
          rdfs:label ?namaProduk .
  ?zatRutin rdfs:label ?obatRutin .

  OPTIONAL {
    ?produk kbr:memilikiKandungan ?zatAktifProduk .
    ?zatAktifProduk rdfs:label ?zatProduk .

    ?interaksi a ?kelasInteraksi ;
               kbr:melibatkanZatAktif ?zatAktifProduk, ?zatRutin ;
               kbr:membutuhkanTindakLanjut ?aksi ;
               rdfs:label ?penjelasan .

    ?kelasInteraksi rdfs:label ?tingkatBahaya .
    ?aksi rdfs:label ?tindakLanjut .

    FILTER (
      ?kelasInteraksi IN (
        kbr:InteraksiMajor,
        kbr:InteraksiModerate,
        kbr:InteraksiMinor
      ) &&
      lang(?zatProduk) = "id" &&
      lang(?penjelasan) = "id" &&
      lang(?tingkatBahaya) = "id" &&
      lang(?tindakLanjut) = "id"
    )

    OPTIONAL { ?interaksi kbr:tingkatBukti ?tingkatBukti }
  }

  FILTER (lang(?namaKasus) = "id" && lang(?namaProduk) = "id" && lang(?obatRutin) = "id")
  BIND(
    IF(BOUND(?interaksi), "interaksi_terdeteksi", "tidak_diketahui")
    AS ?statusData
  )
}
