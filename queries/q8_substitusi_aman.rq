PREFIX kbr: <http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

# T4: Substitusi aman — ganti produk berkandungan Pseudoephedrine (kontraindikasi hipertensi)
# dengan produk lain yang mengindikasikan gejala batuk/pilek tanpa kontraindikasi hipertensi
SELECT DISTINCT ?namaPengganti ?sediaan ?hargaPerUnit ?satuan ?komposisi
WHERE {
  ?prod a kbr:ProduktObat ;
        kbr:namaDagang ?namaPengganti ;
        kbr:memilikiBentukSediaan ?bs ;
        kbr:memilikiKandungan/kbr:mengindikasikanGejalaZat <http://purl.obolibrary.org/obo/SYMP_0000025> ;
        kbr:komposisiTeks ?komposisi .
  ?bs rdfs:label ?sediaan .
  OPTIONAL { ?prod kbr:hargaPerUnitRp ?hargaPerUnit ; kbr:satuanUnit ?satuan }
  FILTER NOT EXISTS { ?prod kbr:memilikiKandungan/kbr:kontraindikasiBagi kbr:HipertensiTidakTerkontrol }
  FILTER (lang(?sediaan) = "id")
}
ORDER BY ?hargaPerUnit ?namaPengganti
LIMIT 20
