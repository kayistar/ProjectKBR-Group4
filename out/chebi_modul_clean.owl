    <!-- http://purl.obolibrary.org/obo/CHEBI_35620 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35620">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35554"/>
        <obo:IAO_0000115>A drug used to cause dilation of the blood vessels.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:35620</oboInOwl:id>
