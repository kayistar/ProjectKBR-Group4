    <!-- http://purl.obolibrary.org/obo/CHEBI_35816 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35816">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_64912"/>
        <obo:IAO_0000115>A substance that suppresses &lt;em&gt;Mycobacterium leprae&lt;/em&gt;, ameliorates the clinical manifestations of leprosy, and/or reduces the incidence and severity of leprous reactions.</obo:IAO_0000115>
