        <owl:annotatedTarget>wikipedia.en:Allergen</owl:annotatedTarget>
        <oboInOwl:source>wikipedia.en</oboInOwl:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_50905 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_50905">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_52209"/>
        <obo:IAO_0000115>A role played by a chemical compound  in biological systems with adverse consequences in embryo developments, leading to birth defects, embryo death or altered development, growth retardation and functional defect.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:50905</oboInOwl:id>
