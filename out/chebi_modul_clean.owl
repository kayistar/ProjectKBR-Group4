        <rdfs:label>steroid</rdfs:label>
        <chemrof:charge rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</chemrof:charge>
        <chemrof:generalized_empirical_formula>C19H31R</chemrof:generalized_empirical_formula>
        <chemrof:mass rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">259.45</chemrof:mass>
        <chemrof:monoisotopic_mass rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">259.24258</chemrof:monoisotopic_mass>
        <chemrof:smiles_string>*C1CCC2C3CCC4CCCCC4(C)C3CCC12C</chemrof:smiles_string>
