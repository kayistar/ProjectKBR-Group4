    <!-- http://purl.obolibrary.org/obo/CHEBI_76983 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_76983">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35358"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_47857"/>
        <obo:IAO_0000115>A urea in which one of the hydrogens attached to a nitrogen of the urea group is replaced by a sulfonyl group. The &lt;em&gt;N&lt;/em&gt;-sulfonylurea moiety is a key group in various herbicides, as well as in a number of antidiabetic drugs used in the management of type 2 diabetis mellitus.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>pubmed:23237384</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>pubmed:23594109</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>pubmed:23609875</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>wikipedia.en:Sulfonylurea</oboInOwl:hasDbXref>
