        <rdfs:label>carbon oxoacid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35610 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35610">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_23888"/>
        <obo:IAO_0000115>A substance that inhibits or prevents the proliferation of neoplasms.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
