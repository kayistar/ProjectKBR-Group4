        <rdfs:label>proteinogenic amino acid derivative</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_83813 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_83813">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33709"/>
        <obo:IAO_0000115>Any of the 23 α-amino acids that are precursors to proteins, and are incorporated into proteins during translation. The group includes the 20 amino acids encoded by the nuclear genes of eukaryotes together with selenocysteine, pyrrolysine, and &lt;em&gt;N&lt;/em&gt;-formylmethionine. Apart from glycine, which is non-chiral, all have &lt;small&gt;L&lt;/small&gt; configuration.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>wikipedia.en:Proteinogenic_amino_acid</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:83813</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/chebi/3_STAR"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/chebi.owl"/>
        <rdfs:label>proteinogenic amino acid</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHEBI_83813"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDbXref"/>
        <owl:annotatedTarget>wikipedia.en:Proteinogenic_amino_acid</owl:annotatedTarget>
        <oboInOwl:source>wikipedia.en</oboInOwl:source>
    </owl:Axiom>
    


