        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/chebi.owl"/>
        <rdfs:label>food component</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_78298 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_78298">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_51086"/>
        <obo:IAO_0000115>Any minor or unwanted substance introduced into the environment that can have undesired effects.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:78298</oboInOwl:id>
