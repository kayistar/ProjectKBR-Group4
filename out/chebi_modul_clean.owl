        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_67013"/>
        <obo:IAO_0000115>A methyl-branched fatty acid anion obtained by deprotonation of the carboxy group of any 2-methyl fatty acid; major species at pH 7.3.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:83976</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/chebi/3_STAR"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/chebi.owl"/>
        <rdfs:label>2-methyl fatty acid anion</rdfs:label>
        <chemrof:charge rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-1</chemrof:charge>
        <chemrof:generalized_empirical_formula>C3H4O2R</chemrof:generalized_empirical_formula>
        <chemrof:mass rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">72.063</chemrof:mass>
        <chemrof:monoisotopic_mass rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">72.02113</chemrof:monoisotopic_mass>
        <chemrof:smiles_string>*C(C)C(=O)[O-]</chemrof:smiles_string>
    </owl:Class>
    


