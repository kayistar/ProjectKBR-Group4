        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_64047"/>
        <obo:IAO_0000115>A food additive that imparts colour to food. In European countries, E-numbers for permitted food colours are from E 100 to E 199, divided into yellows (E 100-109), oranges (E 110-119), reds (E 120-129), blues and violets (E 130-139), greens (E 140-149), browns and blacks (E 150-159), and others (E 160-199).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>wikipedia.en:Food_coloring</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:77182</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/chebi/3_STAR"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/chebi.owl"/>
        <rdfs:label>food colouring</rdfs:label>
    </owl:Class>
    <owl:Axiom>
