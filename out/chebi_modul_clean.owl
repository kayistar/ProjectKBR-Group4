        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35470"/>
        <obo:IAO_0000115>A loosely defined grouping of drugs that have effects on psychological function.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>wikipedia.en:Psychotropic_drug</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:35471</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/chebi/3_STAR"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/chebi.owl"/>
        <rdfs:label>psychotropic drug</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35471"/>
