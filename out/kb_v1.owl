  <!-- ======================================================= -->
  <!-- Ontology: kb_v1.owl                                     -->
  <!-- Group 4 KBR - Interaksi Obat Batuk-Pilek Indonesia      -->
  <!-- Generated: 2026-11-16T14:22:34.628917+07:00                       -->
  <!-- ======================================================= -->
  <owl:Ontology rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl">
    <rdfs:label xml:lang="en">KB v1 Drug Interaction Knowledge Base (Cough &amp; Cold Products - Indonesia)</rdfs:label>
    <rdfs:label xml:lang="id">KB v1 Basis Pengetahuan Interaksi Obat Batuk-Pilek (Produk Apotek Indonesia)</rdfs:label>
    <owl:versionIRI rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl/1.0"/>
    <rdfs:comment xml:lang="id">Basis pengetahuan interaksi obat batuk-pilek generasi pertama. TBox mendefinisikan kelas produk, zat aktif, gejala, interaksi, tindak lanjut klinis, serta 8 aturan GCI inferensi. ABox mendaftarkan 12 individu produk apotek Indonesia pilihan dari data K24Klik.</rdfs:comment>
    <oboInOwl:date>2026-11-16T14:22:34.628917+07:00</oboInOwl:date>
    <oboInOwl:creator xml:lang="id">Group 4 KBR - Universitas Sebelas Maret, Semester 5, 2026/2027</oboInOwl:creator>
  </owl:Ontology>

