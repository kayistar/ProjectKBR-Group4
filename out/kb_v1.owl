  <!-- ======================================================= -->

  <owl:AnnotationProperty rdf:about="http://www.geneontology.org/formats/oboInOwl#date">
    <rdfs:label>date</rdfs:label>
  </owl:AnnotationProperty>

  <owl:AnnotationProperty rdf:about="http://www.geneontology.org/formats/oboInOwl#creator">
    <rdfs:label>creator</rdfs:label>
  </owl:AnnotationProperty>

  <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#altLabel">
    <rdfs:label>altLabel</rdfs:label>
  </owl:AnnotationProperty>

  <!-- ======================================================= -->
  <!-- A. OBJECT PROPERTIES                                    -->
  <!-- ======================================================= -->

  <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#memilikiKandungan">
    <rdfs:label xml:lang="id">memiliki kandungan zat aktif</rdfs:label>
    <rdfs:label xml:lang="en">has active ingredient</rdfs:label>
    <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#ProduktObat"/>
    <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#ZatAktif"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#mengindikasikanGejala">
    <rdfs:label xml:lang="id">mengindikasikan / mengatasi gejala</rdfs:label>
    <rdfs:label xml:lang="en">indicates symptom</rdfs:label>
    <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#ProduktObat"/>
    <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#Gejala"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#memilikiEfekSamping">
    <rdfs:label xml:lang="id">memiliki efek samping yang mungkin terjadi</rdfs:label>
    <rdfs:label xml:lang="en">has side effect symptom</rdfs:label>
    <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#ProduktObat"/>
    <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#Gejala"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#memilikiInteraksiDengan">
    <rdfs:label xml:lang="id">memiliki interaksi farmakokinetik/farmakodinamik dengan</rdfs:label>
    <rdfs:label xml:lang="en">has drug interaction with</rdfs:label>
    <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#ZatAktif"/>
    <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#ZatAktif"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#menghasilkanInteraksi">
    <rdfs:label xml:lang="id">menghasilkan / menyebabkan kejadian interaksi</rdfs:label>
    <rdfs:label xml:lang="en">produces drug interaction event</rdfs:label>
    <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#ZatAktif"/>
    <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#InteraksiObat"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#membutuhkanTindakLanjut">
    <rdfs:label xml:lang="id">membutuhkan tindak lanjut klinis tertentu</rdfs:label>
    <rdfs:label xml:lang="en">requires clinical follow-up</rdfs:label>
    <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#InteraksiObat"/>
    <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#TindakLanjut"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#dimetabolismeOleh">
    <rdfs:label xml:lang="id">dimetabolisme / diubah oleh enzim CYP450</rdfs:label>
    <rdfs:label xml:lang="en">is metabolized by enzyme</rdfs:label>
    <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#ZatAktif"/>
    <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#EnzimCYP450"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#memilikiGolongan">
    <rdfs:label xml:lang="id">memiliki golongan regulasi BPOM</rdfs:label>
    <rdfs:label xml:lang="en">has regulatory class</rdfs:label>
    <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#ProduktObat"/>
    <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#GolonganObat"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#memilikiBentukSediaan">
    <rdfs:label xml:lang="id">memiliki bentuk sediaan farmasi</rdfs:label>
    <rdfs:label xml:lang="en">has dosage form</rdfs:label>
    <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#ProduktObat"/>
    <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#BentukSediaan"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#diproduksiOleh">
    <rdfs:label xml:lang="id">diproduksi / dipasarkan oleh produsen farmasi</rdfs:label>
    <rdfs:label xml:lang="en">is manufactured by</rdfs:label>
    <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#ProduktObat"/>
    <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#kontraindikasiBagi">
    <rdfs:label xml:lang="id">bersifat kontraindikasi bagi kondisi pasien tertentu</rdfs:label>
    <rdfs:label xml:lang="en">is contraindicated for patient condition</rdfs:label>
    <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#ProduktObat"/>
    <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#KondisiPasien"/>
  </owl:ObjectProperty>

  <!-- ======================================================= -->
  <!-- B. DATA PROPERTIES                                      -->
  <!-- ======================================================= -->

  <owl:DatatypeProperty rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#namaDagang">
    <rdfs:label xml:lang="id">nama dagang / merek produk (terdaftar BPOM)</rdfs:label>
    <rdfs:label xml:lang="en">trade name</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#namaProdusen">
    <rdfs:label xml:lang="id">nama perusahaan farmasi produsen/pemegang izin</rdfs:label>
    <rdfs:label xml:lang="en">manufacturer name</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#nomorBPOM">
    <rdfs:label xml:lang="id">nomor izin edar resmi BPOM (NIE)</rdfs:label>
    <rdfs:label xml:lang="en">BPOM registration no</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#hargaRupiah">
    <rdfs:label xml:lang="id">harga satuan terkecil kemasan (Rupiah)</rdfs:label>
    <rdfs:label xml:lang="en">unit price IDR</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#kodeATC">
    <rdfs:label xml:lang="id">kode ATC Level 5 WHO (Anatomical Therapeutic Chemical)</rdfs:label>
    <rdfs:label xml:lang="en">ATC code</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#chebiID">
    <rdfs:label xml:lang="id">identifier ChEBI zat kimia aktif</rdfs:label>
    <rdfs:label xml:lang="en">ChEBI identifier</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#doseInfoPer5mL">
    <rdfs:label xml:lang="id">informasi dosis zat aktif per unit sediaan</rdfs:label>
    <rdfs:label xml:lang="en">dose info</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#nomorSlugK24">
    <rdfs:label xml:lang="id">slug/ID unik produk pada katalog K24Klik</rdfs:label>
    <rdfs:label xml:lang="en">K24Klik slug</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#urlK24">
    <rdfs:label xml:lang="id">URL halaman detail produk pada K24Klik</rdfs:label>
    <rdfs:label xml:lang="en">K24Klik product URL</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#tingkatBukti">
    <rdfs:label xml:lang="id">tingkat bukti literatur interaksi (A/B/C)</rdfs:label>
    <rdfs:label xml:lang="en">evidence level</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <!-- ======================================================= -->
  <!-- C. TBOX – CLASS HIERARCHY                               -->
  <!-- ======================================================= -->

  <owl:Class rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#ProduktObat">
    <rdfs:label xml:lang="id">Produk Obat</rdfs:label>
    <rdfs:label xml:lang="en">Pharmaceutical Product</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:comment xml:lang="id">Kelas akar semua produk farmasi yang terdaftar di apotek Indonesia dan memiliki NIE BPOM.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#ObatBatukPilek">
    <rdfs:label xml:lang="id">Obat Batuk dan/atau Pilek</rdfs:label>
    <rdfs:label xml:lang="en">Cough and/or Cold Medication</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#ProduktObat"/>
    <rdfs:comment xml:lang="id">Produk farmasi yang diindikasikan untuk mengatasi gejala batuk, pilek, atau keduanya; berisi minimal satu zat aktif antitusif, ekspektoran, mukolitik, atau dekongestan.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#ObatBatukMurni">
    <rdfs:label xml:lang="id">Obat Batuk (Murni)</rdfs:label>
    <rdfs:label xml:lang="en">Cough-only Medication</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#ObatBatukPilek"/>
    <rdfs:comment xml:lang="id">Produk berindikasi khusus batuk: mengandung antitusif (Dextromethorphan, Diphenhydramine) dan/atau ekspektoran/mukolitik (Guaifenesin, Bromhexine, Ambroxol) tanpa dekongestan nasal.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#ObatPilekMurni">
    <rdfs:label xml:lang="id">Obat Pilek / Flu (Murni)</rdfs:label>
    <rdfs:label xml:lang="en">Cold/Flu-only Medication</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#ObatBatukPilek"/>
    <rdfs:comment xml:lang="id">Produk berindikasi khusus pilek/flu: mengandung dekongestan (Pseudoephedrine, Phenylephrine) dan/atau antihistamin H1 (CTM, Triprolidine) atau antipiretik, tanpa antitusif.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#ObatKombinasiBatukPilek">
    <rdfs:label xml:lang="id">Obat Kombinasi Batuk dan Pilek</rdfs:label>
    <rdfs:label xml:lang="en">Combination Cough-Cold Medication</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#ObatBatukPilek"/>
    <rdfs:comment xml:lang="id">Produk multi-komponen yang sekaligus mengandung antitusif/ekspektoran DAN dekongestan/antihistamin. Contoh: Siladex Cough N Cold, Actifed Merah, Komix, Procold.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#ZatAktif">
    <rdfs:label xml:lang="id">Zat Aktif / Bahan Farmakologis</rdfs:label>
    <rdfs:label xml:lang="en">Active Pharmaceutical Ingredient (API)</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:comment xml:lang="id">Senyawa kimia atau bahan biologis yang memberikan efek farmakologis dalam suatu produk obat. Setiap individu ZatAktif terkait dengan entri ChEBI, kode ATC, dan data enzim metabolisme.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#EnzimCYP450">
    <rdfs:label xml:lang="id">Enzim CYP450 Metabolisme</rdfs:label>
    <rdfs:label xml:lang="en">CYP450 Metabolic Enzyme</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:comment xml:lang="id">Enzim sitokrom P450 yang bertanggung jawab atas metabolisme hepatik obat. Terkait dengan entri PRO (Protein Ontology). Sub-kelas: CYP3A4, CYP2D6, CYP2C19, CYP2C9.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#CYP3A4">
    <rdfs:label xml:lang="id">CYP3A4 (Enzim Metabolisme Utama)</rdfs:label>
    <rdfs:label xml:lang="en">CYP3A4 Enzyme</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#EnzimCYP450"/>
    <rdfs:comment xml:lang="id">Isoform CYP450 paling dominan (>50% obat); major metaboliser statin, azol, amlodipine, dextromethorphan.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#CYP2D6">
    <rdfs:label xml:lang="id">CYP2D6 (Enzim Metabolisme Utama)</rdfs:label>
    <rdfs:label xml:lang="en">CYP2D6 Enzyme</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#EnzimCYP450"/>
    <rdfs:comment xml:lang="id">Isoform polimorfik; metaboliser utama dextromethorphan (O-demetilasi), codeine, dan antihistamin.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#CYP2C19">
    <rdfs:label xml:lang="id">CYP2C19 (Enzim Metabolisme Utama)</rdfs:label>
    <rdfs:label xml:lang="en">CYP2C19 Enzyme</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#EnzimCYP450"/>
    <rdfs:comment xml:lang="id">Isoform polimorfik; bioaktivasi clopidogrel, metabolisme omeprazole. Dihambat oleh omeprazole → interaksi kritis.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#CYP2C9">
    <rdfs:label xml:lang="id">CYP2C9 (Enzim Metabolisme Utama)</rdfs:label>
    <rdfs:label xml:lang="en">CYP2C9 Enzyme</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#EnzimCYP450"/>
    <rdfs:comment xml:lang="id">Metaboliser warfarin S-enantiomer, glimepiride, ibuprofen, fluconazole. Inhibitor kuat = azol.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#Gejala">
    <rdfs:label xml:lang="id">Gejala Klinis</rdfs:label>
    <rdfs:label xml:lang="en">Clinical Symptom</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:comment xml:lang="id">Manifestasi klinis yang diamati pada pasien, baik sebagai tanda indikasi penyakit maupun efek samping atau efek berbahaya (red flag) akibat penggunaan obat.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#GejalaIndikasi">
    <rdfs:label xml:lang="id">Gejala Indikasi Penyakit</rdfs:label>
    <rdfs:label xml:lang="en">Indication Symptom</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#Gejala"/>
    <rdfs:comment xml:lang="id">Gejala yang menjadi target terapi produk obat batuk-pilek (mis. batuk, pilek, demam, hidung tersumbat).</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#GejalaEfekSamping">
    <rdfs:label xml:lang="id">Gejala Efek Samping Obat</rdfs:label>
    <rdfs:label xml:lang="en">Side Effect Symptom</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#Gejala"/>
    <rdfs:comment xml:lang="id">Efek yang tidak diinginkan akibat penggunaan obat, misalnya mengantuk, palpitasi, mulut kering.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#GejalaRedFlag">
    <rdfs:label xml:lang="id">Gejala Bahaya / Red Flag</rdfs:label>
    <rdfs:label xml:lang="en">Red Flag Symptom</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#Gejala"/>
    <rdfs:comment xml:lang="id">Gejala yang mengindikasikan kondisi serius: sesak napas, mengi, batuk berdarah, urin gelap. Memerlukan rujukan segera ke dokter.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#InteraksiObat">
    <rdfs:label xml:lang="id">Interaksi Obat</rdfs:label>
    <rdfs:label xml:lang="en">Drug-Drug Interaction</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:comment xml:lang="id">Modifikasi efek farmakokinetik atau farmakodinamik suatu obat akibat kehadiran obat atau bahan lain, yang dapat meningkatkan toksisitas atau menurunkan efikasi terapi.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#InteraksiMajor">
    <rdfs:label xml:lang="id">Interaksi Major (Kontraindikasi Klinis)</rdfs:label>
    <rdfs:label xml:lang="en">Major Drug Interaction</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#InteraksiObat"/>
    <rdfs:comment xml:lang="id">Interaksi dengan risiko tinggi menyebabkan bahaya serius atau kematian; umumnya harus dihindari atau memerlukan penggantian obat segera (mis. itraconazole + simvastatin, omeprazole + clopidogrel).</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#InteraksiModerate">
    <rdfs:label xml:lang="id">Interaksi Moderate (Perlu Pemantauan Klinis)</rdfs:label>
    <rdfs:label xml:lang="en">Moderate Drug Interaction</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#InteraksiObat"/>
    <rdfs:comment xml:lang="id">Interaksi dengan konsekuensi klinis bermakna yang masih dapat dikelola dengan pemantauan atau penyesuaian dosis; konsultasikan ke apoteker.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#InteraksiMinor">
    <rdfs:label xml:lang="id">Interaksi Minor (Risiko Klinis Rendah)</rdfs:label>
    <rdfs:label xml:lang="en">Minor Drug Interaction</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#InteraksiObat"/>
    <rdfs:comment xml:lang="id">Interaksi dengan efek kecil dan jarang bermakna secara klinis; monitoring rutin cukup.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#TindakLanjut">
    <rdfs:label xml:lang="id">Tindak Lanjut Klinis</rdfs:label>
    <rdfs:label xml:lang="en">Clinical Follow-up Action</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:comment xml:lang="id">Rekomendasi aksi klinis yang dihasilkan sistem KB setelah mendeteksi interaksi atau gejala tertentu.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#SegeraKeDokter">
    <rdfs:label xml:lang="id">Segera ke Dokter / IGD</rdfs:label>
    <rdfs:label xml:lang="en">Seek Immediate Medical Attention</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#TindakLanjut"/>
    <rdfs:comment xml:lang="id">Kondisi darurat atau kontraindikasi berat; pasien harus segera dirujuk ke fasilitas kesehatan.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#TanyaApoteker">
    <rdfs:label xml:lang="id">Konsultasikan ke Apoteker</rdfs:label>
    <rdfs:label xml:lang="en">Consult Pharmacist</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#TindakLanjut"/>
    <rdfs:comment xml:lang="id">Interaksi moderate atau efek samping bermakna; pasien disarankan mendiskusikan dengan apoteker sebelum melanjutkan penggunaan.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#Pantau">
    <rdfs:label xml:lang="id">Pantau Mandiri</rdfs:label>
    <rdfs:label xml:lang="en">Self-monitor</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#TindakLanjut"/>
    <rdfs:comment xml:lang="id">Risiko rendah; pasien dapat melanjutkan pengobatan sambil memantau gejala secara mandiri sesuai petunjuk pada kemasan.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#GolonganObat">
    <rdfs:label xml:lang="id">Golongan Regulasi Obat (BPOM)</rdfs:label>
    <rdfs:label xml:lang="en">Drug Regulatory Class (BPOM)</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:comment xml:lang="id">Klasifikasi produk farmasi berdasarkan ketentuan Permenkes Indonesia (BPOM).</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#ObatBebas">
    <rdfs:label xml:lang="id">Obat Bebas (Lingkaran Hijau)</rdfs:label>
    <rdfs:label xml:lang="en">Over-the-Counter Drug (Green Circle)</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#GolonganObat"/>
    <rdfs:comment xml:lang="id">Dapat dibeli tanpa resep di apotek/toko obat; logo lingkaran hijau BPOM.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#ObatBebasTerbatas">
    <rdfs:label xml:lang="id">Obat Bebas Terbatas (Lingkaran Biru)</rdfs:label>
    <rdfs:label xml:lang="en">Limited OTC Drug (Blue Circle)</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#GolonganObat"/>
    <rdfs:comment xml:lang="id">Dapat dibeli tanpa resep namun dibatasi jumlah/kemasan; logo lingkaran biru BPOM.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#ObatHerbalJamu">
    <rdfs:label xml:lang="id">Obat Herbal / Jamu / Fitofarmaka</rdfs:label>
    <rdfs:label xml:lang="en">Herbal/Jamu/Phytopharmacy Product</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#GolonganObat"/>
    <rdfs:comment xml:lang="id">Produk berbasis bahan alam (simplisia, ekstrak); mencakup jamu, obat herbal terstandar, dan fitofarmaka.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#BentukSediaan">
    <rdfs:label xml:lang="id">Bentuk Sediaan Farmasi</rdfs:label>
    <rdfs:label xml:lang="en">Pharmaceutical Dosage Form</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:comment xml:lang="id">Bentuk fisik produk farmasi yang dikonsumsi oleh pasien.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#Sirup">
    <rdfs:label xml:lang="id">Sediaan Sirup / Suspensi</rdfs:label>
    <rdfs:label xml:lang="en">Syrup / Suspension</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#BentukSediaan"/>
    <rdfs:comment xml:lang="id">Sediaan cair oral; umumnya lebih disukai untuk anak-anak.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#Tablet">
    <rdfs:label xml:lang="id">Sediaan Tablet / Kaplet</rdfs:label>
    <rdfs:label xml:lang="en">Tablet / Caplet</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#BentukSediaan"/>
    <rdfs:comment xml:lang="id">Sediaan padat oral; termasuk tablet biasa, kaplet, dan tablet salut.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#Kapsul">
    <rdfs:label xml:lang="id">Sediaan Kapsul</rdfs:label>
    <rdfs:label xml:lang="en">Capsule</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#BentukSediaan"/>
    <rdfs:comment xml:lang="id">Sediaan padat dengan cangkang gelatin yang menutupi serbuk atau butiran.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#Sachet">
    <rdfs:label xml:lang="id">Sediaan Sachet / Serbuk</rdfs:label>
    <rdfs:label xml:lang="en">Sachet / Powder</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#BentukSediaan"/>
    <rdfs:comment xml:lang="id">Sediaan serbuk atau cairan dalam kemasan sekali pakai individual.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#KondisiPasien">
    <rdfs:label xml:lang="id">Kondisi Pasien yang Relevan</rdfs:label>
    <rdfs:label xml:lang="en">Patient Condition</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:comment xml:lang="id">Kondisi medis pasien yang mempengaruhi pemilihan atau keamanan terapi obat.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#HipertensiTidakTerkontrol">
    <rdfs:label xml:lang="id">Hipertensi Tidak Terkontrol</rdfs:label>
    <rdfs:label xml:lang="en">Uncontrolled Hypertension</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#KondisiPasien"/>
    <rdfs:comment xml:lang="id">Tekanan darah sistolik ≥160 mmHg atau diastolik ≥100 mmHg; kontraindikasi dekongestan oral (PSE, PE).</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#GagalJantung">
    <rdfs:label xml:lang="id">Gagal Jantung</rdfs:label>
    <rdfs:label xml:lang="en">Heart Failure</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#KondisiPasien"/>
    <rdfs:comment xml:lang="id">Disfungsi pompa jantung; kontraindikasi dekongestan adrenergik pada pengguna digoxin/antiaritmia.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#ProstatBPH">
    <rdfs:label xml:lang="id">Pembesaran Prostat BPH</rdfs:label>
    <rdfs:label xml:lang="en">Benign Prostatic Hyperplasia</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#KondisiPasien"/>
    <rdfs:comment xml:lang="id">Risiko retensi urin diperparah oleh efek antikolinergik antihistamin generasi 1.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#DuplikasiTerapetik">
    <rdfs:label xml:lang="id">Duplikasi Terapetik (Kontra-indikasi Farmasi)</rdfs:label>
    <rdfs:label xml:lang="en">Therapeutic Duplication</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:comment xml:lang="id">Kondisi di mana pasien mengonsumsi dua atau lebih obat dengan mekanisme aksi yang sama/tumpang tindih, meningkatkan risiko efek samping tanpa manfaat tambahan. Contoh: CTM + Diphenhydramine.</rdfs:comment>
  </owl:Class>

  <!-- ======================================================= -->
  <!-- D. GCI RULES (General Concept Inclusions)  R-01..R-08  -->
  <!-- ======================================================= -->

  <!-- R-01: Setiap produk yang mengandung antitusif → subclass ObatBatukMurni -->
  <!-- Encoded as: ObatBatukMurni ⊑ ProduktObat ⊓ (∃memilikiKandungan.(Antitusif ⊔ Ekspektoran ⊔ Mukolitik)) -->
  <owl:Class rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#ObatBatukMurni">
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#ProduktObat"/>
          <owl:Restriction>
            <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#memilikiKandungan"/>
            <owl:someValuesFrom>
              <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                  <!-- Antitusif: DXM (CHEBI:4480) -->
                  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CHEBI_4480"/>
                  <!-- Ekspektoran: Guaifenesin (CHEBI:5536) -->
                  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CHEBI_5536"/>
                  <!-- Mukolitik: Bromhexine (CHEBI:3180) -->
                  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CHEBI_3180"/>
                  <!-- Mukolitik: Ambroxol (CHEBI:2688) -->
                  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CHEBI_2688"/>
                </owl:unionOf>
              </owl:Class>
            </owl:someValuesFrom>
          </owl:Restriction>
          <owl:Restriction>
            <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#memilikiKandungan"/>
            <owl:allValuesFrom>
              <owl:Class>
                <owl:complementOf>
                  <owl:Class>
                    <owl:unionOf rdf:parseType="Collection">
                      <!-- Dekongestan: PSE (CHEBI:50346), PE (CHEBI:8093) -->
                      <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CHEBI_50346"/>
                      <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CHEBI_8093"/>
                    </owl:unionOf>
                  </owl:Class>
                </owl:complementOf>
              </owl:Class>
            </owl:allValuesFrom>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>

  <!-- R-02: Setiap produk yang mengandung dekongestan (dan tidak antitusif) → ObatPilekMurni -->
  <owl:Class rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#ObatPilekMurni">
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#ProduktObat"/>
          <owl:Restriction>
            <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#memilikiKandungan"/>
            <owl:someValuesFrom>
              <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CHEBI_50346"/>
                  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CHEBI_8093"/>
                </owl:unionOf>
              </owl:Class>
            </owl:someValuesFrom>
          </owl:Restriction>
          <owl:Restriction>
            <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#memilikiKandungan"/>
            <owl:allValuesFrom>
              <owl:Class>
                <owl:complementOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_4480"/>
              </owl:Class>
            </owl:allValuesFrom>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>

  <!-- R-03: Produk dengan antihistamin-H1 gen 1 → wajib punya efek samping Mengantuk -->
  <owl:Class rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#_AH1Product">
    <rdfs:label xml:lang="id">Produk mengandung antihistamin H1 generasi pertama</rdfs:label>
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#ProduktObat"/>
          <owl:Restriction>
            <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#memilikiKandungan"/>
            <owl:someValuesFrom>
              <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                  <!-- CTM: Chlorpheniramine (CHEBI:3587) -->
                  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CHEBI_3587"/>
                  <!-- Diphenhydramine (CHEBI:4634) -->
                  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CHEBI_4634"/>
                  <!-- Triprolidine – kelas lokal -->
                  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#Triprolidine"/>
                  <!-- Doxylamine – kelas lokal -->
                  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#Doxylamine"/>
                </owl:unionOf>
              </owl:Class>
            </owl:someValuesFrom>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#memilikiEfekSamping"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000024"/>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>

  <owl:Class rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#Triprolidine">
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#ZatAktif"/>
    <rdfs:label xml:lang="en">Triprolidine</rdfs:label>
    <rdfs:comment xml:lang="id">Antihistamin H1 Gen-1 sedatif; kombinasi dekongestan populer (mis. Actifed).</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#Doxylamine">
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#ZatAktif"/>
    <rdfs:label xml:lang="en">Doksylamine</rdfs:label>
    <rdfs:comment xml:lang="id">Antihistamin H1 Gen-1 sedatif kuat; antitusif di Vicks F44 DWS, Siladex Cough N Cold.</rdfs:comment>
  </owl:Class>

  <!-- R-04: Produk dengan dekongestan oral → memilikiEfekSamping Palpitasi -->
  <owl:Class rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#_DekongestanProduct">
    <rdfs:label xml:lang="id">Produk mengandung dekongestan oral (PSE atau PE)</rdfs:label>
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#ProduktObat"/>
          <owl:Restriction>
            <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#memilikiKandungan"/>
            <owl:someValuesFrom>
              <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CHEBI_50346"/>
                  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CHEBI_8093"/>
                </owl:unionOf>
              </owl:Class>
            </owl:someValuesFrom>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#memilikiEfekSamping"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000530"/>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>

  <!-- R-05: Semua interaksi Major → wajib punya tindak lanjut SegeraKeDokter -->
  <owl:Class rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#InteraksiMajor">
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#membutuhkanTindakLanjut"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#SegeraKeDokter"/>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>

  <!-- R-06: Semua interaksi Moderate → wajib punya tindak lanjut TanyaApoteker ATAU Pantau -->
  <owl:Class rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#InteraksiModerate">
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#membutuhkanTindakLanjut"/>
        <owl:someValuesFrom>
          <owl:Class>
            <owl:unionOf rdf:parseType="Collection">
              <rdf:Description rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#TanyaApoteker"/>
              <rdf:Description rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#Pantau"/>
            </owl:unionOf>
          </owl:Class>
        </owl:someValuesFrom>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>

  <!-- R-07: Produk dengan CTM DAN Diphenhydramine → terdeteksi DuplikasiTerapetik (menyebabkan sedasi berat) -->
  <owl:Class rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#ProdukKombinasiCTMDPH">
    <rdfs:label xml:lang="id">Produk CTM + Diphenhydramine = Duplikasi Terapetik Antihistamin H1</rdfs:label>
    <owl:equivalentClass>
      <owl:Class>
