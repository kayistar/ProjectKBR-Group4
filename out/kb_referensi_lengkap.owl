    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_53746">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_76835"/>
        <obo:IAO_0000115>An EC 1.1.1.* (oxidoreductase acting on donor CH-OH group, NAD&lt;small&gt;&lt;sup&gt;+&lt;/small&gt;&lt;/sup&gt; or NADP&lt;small&gt;&lt;sup&gt;+&lt;/small&gt;&lt;/sup&gt; acceptor) inhibitor that interferes with the action of IMP dehydrogenase (EC 1.1.1.205), so blocking de novo biosynthesis of purine nucleotides.</obo:IAO_0000115>
