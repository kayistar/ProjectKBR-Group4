    <!-- http://purl.obolibrary.org/obo/RO_0018036 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0018036">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
