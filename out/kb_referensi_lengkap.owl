    <!-- http://purl.obolibrary.org/obo/SYMP_0000024 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/SYMP_0000024">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000410"/>
        <obo:IAO_0000115>A neurological and physiological symptom that is characterized by a feeling of being more sleepy than normal during the day. People who are drowsy may fall asleep in when they do not want to or at times which can lead to safety concerns.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>drowsy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>somnolence</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0000024</oboInOwl:id>
        <rdfs:comment xml:lang="id">[GejalaEfekSamping] Rekomendasi: TanyaApoteker. Efek penekanan SSP dari antihistamin generasi pertama (CTM, Diphenhydramine); jangan menyetir.</rdfs:comment>
        <rdfs:label>drowsiness</rdfs:label>
        <skos:altLabel xml:lang="id">Mengantuk / rasa kantuk berat</skos:altLabel>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000024"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A neurological and physiological symptom that is characterized by a feeling of being more sleepy than normal during the day. People who are drowsy may fall asleep in when they do not want to or at times which can lead to safety concerns.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://medlineplus.gov/ency/article/003208.htm</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/SYMP_0000025 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/SYMP_0000025">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000614"/>
        <obo:IAO_0000115>A cough that is characterized by a lack of accompanied phlegm production.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>nonproductive cough</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0000025</oboInOwl:id>
        <rdfs:comment xml:lang="id">[GejalaIndikasi] Rekomendasi: Pantau. Batuk tanpa produksi dahak/mukus, sering teriritasi di tenggorokan (indikasi antitusif).</rdfs:comment>
        <rdfs:label>dry cough</rdfs:label>
        <skos:altLabel xml:lang="id">Batuk kering / tidak berdahak</skos:altLabel>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000025"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>nonproductive cough</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://www.healthline.com/health/dry-cough</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/SYMP_0000099 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/SYMP_0000099">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000892"/>
        <obo:IAO_0000115>A sensation perception that is characterized by an unpleasant sensation that usually indicates the body is threatened or damaged. The sensation may be sharp or dull, short-lived or chronic, intermittent or continual, confined to one area or spread over the entire body.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0000099</oboInOwl:id>
        <rdfs:label>pain</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000099"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A sensation perception that is characterized by an unpleasant sensation that usually indicates the body is threatened or damaged. The sensation may be sharp or dull, short-lived or chronic, intermittent or continual, confined to one area or spread over the entire body.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:http://www.nationalpainfoundation.org/MyTreatment/articles/Cancer_PainDefinitions.asp</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/SYMP_0000139 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/SYMP_0000139">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000514"/>
        <obo:IAO_0000115>A respiratory system and chest symptom that is characterized by a sudden violent spasmodic audible expiration of breath through the nose and mouth especially as a reflex act following irritation of the nasal mucous membrane.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0000139</oboInOwl:id>
        <rdfs:comment xml:lang="id">[GejalaIndikasi] Rekomendasi: Pantau. Refleks pengeluaran udara tiba-tiba akibat stimulasi saraf sensorik mukosa hidung.</rdfs:comment>
        <rdfs:label>sneezing</rdfs:label>
        <skos:altLabel xml:lang="id">Bersin-bersin</skos:altLabel>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000139"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A respiratory system and chest symptom that is characterized by a sudden violent spasmodic audible expiration of breath through the nose and mouth especially as a reflex act following irritation of the nasal mucous membrane.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=sneezing</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/SYMP_0000237 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/SYMP_0000237">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000514"/>
        <obo:IAO_0000115>A respiratory system and chest symptom that is characterized by an excessive accumulation especially of blood or mucus.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>blocked nose</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>nasal blockage</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>nasal obstruction</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>stuffed up nose</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>stuffy nose</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0000237</oboInOwl:id>
        <rdfs:label>congestion</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000237"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A respiratory system and chest symptom that is characterized by an excessive accumulation especially of blood or mucus.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=congestion</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/SYMP_0000242 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/SYMP_0000242">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000614"/>
        <obo:IAO_0000115>A cough that is characterized by production and expectoration (bringing up) of sputum that is bright red or pink and frothy.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0000242</oboInOwl:id>
        <rdfs:comment xml:lang="id">[GejalaRedFlag] Rekomendasi: SegeraKeDokter. Hemoptisis; indikasi infeksi parenkim paru serius (mis. TBC, pneumonia berat) bukan batuk biasa.</rdfs:comment>
        <rdfs:label>cough with bloody sputum</rdfs:label>
        <skos:altLabel xml:lang="id">Batuk berdarah / dahak bercampur darah</skos:altLabel>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000242"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A cough that is characterized by production and expectoration (bringing up) of sputum that is bright red or pink and frothy.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://www.webmd.com/lung/coughing-up-blood</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/SYMP_0000260 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/SYMP_0000260">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000386"/>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0000260</oboInOwl:id>
        <rdfs:comment xml:lang="id">[GejalaEfekSamping] Rekomendasi: Pantau. Penurunan sekresi saliva akibat blokade reseptor muskarinik perifer oleh antihistamin.</rdfs:comment>
        <rdfs:label>dry mouth</rdfs:label>
        <skos:altLabel xml:lang="id">Mulut kering / haus</skos:altLabel>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/SYMP_0000287 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/SYMP_0000287">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000528"/>
        <obo:IAO_0000115>Arrhythmia is a cardiovascular system symptom consisting of an alteration in rhythm of the heartbeat either in time or force.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>SYMP:0000288</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>SYMP:0000667</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>SYMP:0000668</oboInOwl:hasAlternativeId>
        <oboInOwl:hasExactSynonym>abnormal heart beat</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>abnormal heart rhythm</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>dysrhythmia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>heart rhythm symptom</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>irregular heartbeat</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>fluctuation of heart rate</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>SYMP:0000287</oboInOwl:id>
        <rdfs:label>arrhythmia</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000287"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Arrhythmia is a cardiovascular system symptom consisting of an alteration in rhythm of the heartbeat either in time or force.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=arrhythmia</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/SYMP_0000372 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/SYMP_0000372">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000388"/>
        <obo:IAO_0000115>A nose symptom that is characterized by an excessive secretion of mucous through the nose.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>runny nose</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0000372</oboInOwl:id>
        <rdfs:comment xml:lang="id">[GejalaIndikasi] Rekomendasi: Pantau. Keluarnya cairan lendir encer dari rongga hidung (indikasi antihistamin).</rdfs:comment>
        <rdfs:label>rhinorrhea</rdfs:label>
        <skos:altLabel xml:lang="id">Pilek / hidung berair</skos:altLabel>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000372"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A nose symptom that is characterized by an excessive secretion of mucous through the nose.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=Rhinorrhea</oboInOwl:hasDbXref>
    </owl:Axiom>
    


