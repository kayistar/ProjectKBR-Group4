    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0018038 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0018038">
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>has_functional_parent</oboInOwl:id>
        <oboInOwl:is_cyclic rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</oboInOwl:is_cyclic>
        <oboInOwl:is_transitive rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</oboInOwl:is_transitive>
