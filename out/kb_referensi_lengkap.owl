        <chemrof:monoisotopic_mass rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">51.99491</chemrof:monoisotopic_mass>
        <chemrof:smiles_string>[1*]/C([2*])=C(/[3*])C([4*])=O</chemrof:smiles_string>
    </owl:Class>
