        <rdfs:label>olefinic compound</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_79020 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_79020">
