    <!-- http://purl.obolibrary.org/obo/CHEBI_78113 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_78113">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_58951"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_58953"/>
        <obo:IAO_0000115>Any saturated fatty acid anion containing 3 carbons. Formed by deprotonation of the carboxylic acid moiety. Major species at pH 7.3.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:78113</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/chebi/3_STAR"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/chebi.owl"/>
        <rdfs:label>fatty acid anion 3:0</rdfs:label>
        <chemrof:charge rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-1</chemrof:charge>
        <chemrof:generalized_empirical_formula>C3H5O2</chemrof:generalized_empirical_formula>
        <chemrof:mass rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">73.071</chemrof:mass>
        <chemrof:monoisotopic_mass rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">73.02895</chemrof:monoisotopic_mass>
        <chemrof:smiles_string>*C(=O)[O-]</chemrof:smiles_string>
    </owl:Class>
    


