    <!-- http://purl.obolibrary.org/obo/CHEBI_86323 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_86323">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_68452"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35718"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_75282"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A compound that has a structure that is related to miconazole, contains an azole (imidazole or triazole) moiety, and has significant systemic antifungal properties.  They inhibit cytochrome P450-dependent enzymes (particularly C14-demethylase) involved in the biosynthesis of ergosterol, which is required for fungal cell membrane structure and function.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>CHEBI:60593</oboInOwl:hasAlternativeId>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:86323</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/chebi/3_STAR"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/chebi.owl"/>
        <rdfs:label>conazole antifungal agent</rdfs:label>
    </owl:Class>
    


