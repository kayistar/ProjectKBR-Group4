        <oboInOwl:id>SYMP:0000597</oboInOwl:id>
        <ns2:label>head and neck symptom</ns2:label>
    </ns1:Class>
    


    

    <ns1:Class rdf:about="http://purl.obolibrary.org/obo/SYMP_0000598">
        <ns2:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000514" />
        <obo:IAO_0000115>A respiratory system and chest symptom that is characterized by a respiration that is not normal and may include, but is not limited to: apnea, eupnea, orthopnea, dyspnea hyperpnea, hyperventilation, hypoventilation, tachypnea, Kussmaul respiration, Cheyne-Stokes respiration, sighing respiration, Biot respiration, apneustic breathing, central neurogenic hyperventilation, and central neurogenic hypoventilation.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD9CM_2005:786.0</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0159053</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_ICD9CM_2005_AUI:A0284202</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0000598</oboInOwl:id>
        <ns2:label>respiratory abnormality</ns2:label>
    </ns1:Class>
    <ns1:Axiom>
        <ns1:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000598" />
        <ns1:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115" />
        <ns1:annotatedTarget>A respiratory system and chest symptom that is characterized by a respiration that is not normal and may include, but is not limited to: apnea, eupnea, orthopnea, dyspnea hyperpnea, hyperventilation, hypoventilation, tachypnea, Kussmaul respiration, Cheyne-Stokes respiration, sighing respiration, Biot respiration, apneustic breathing, central neurogenic hyperventilation, and central neurogenic hypoventilation.</ns1:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/books/NBK470309/</oboInOwl:hasDbXref>
    </ns1:Axiom>
    


    

    <ns1:Class rdf:about="http://purl.obolibrary.org/obo/SYMP_0000604">
        <ns2:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000587" />
        <obo:IAO_0000115>An abnormal chest sound that is characterized by breathing with difficulty usually with a whistling sound.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD9CM_2005:786.07</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0043144</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_ICD9CM_2005_AUI:A0133941</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0000604</oboInOwl:id>
        <ns2:label>wheezing</ns2:label>
    <skos:altLabel xml:lang="id">Napas berbunyi mengi / ngik-ngik</skos:altLabel><skos:altLabel xml:lang="id">mengi</skos:altLabel><skos:altLabel xml:lang="id">napas ngik-ngik</skos:altLabel><ns2:comment xml:lang="id">[GejalaRedFlag] Rekomendasi: SegeraKeDokter. Suara napas berfrekuensi tinggi akibat penyempitan lumen bronkus; butuh evaluasi medis.</ns2:comment><skos:note xml:lang="id">Sinonim awam adalah draf dan perlu validasi apoteker.</skos:note></ns1:Class>
    <ns1:Axiom>
        <ns1:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000604" />
        <ns1:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115" />
        <ns1:annotatedTarget>An abnormal chest sound that is characterized by breathing with difficulty usually with a whistling sound.</ns1:annotatedTarget>
        <oboInOwl:hasDbXref>url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=wheezing</oboInOwl:hasDbXref>
    </ns1:Axiom>
    


    

    <ns1:Class rdf:about="http://purl.obolibrary.org/obo/SYMP_0000610">
        <ns2:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0020045" />
        <obo:IAO_0000115>A  balance symptom that is characterized by a sensation of unsteadiness accompanied by a feeling of movement within the head.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD9CM_2005:780.4</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0476206</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_ICD9CM_2005_AUI:A0243727</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>dizzy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0000610</oboInOwl:id>
        <ns2:label>dizziness</ns2:label>
    <skos:altLabel xml:lang="id">Pusing / melayang</skos:altLabel><skos:altLabel xml:lang="id">pusing</skos:altLabel><skos:altLabel xml:lang="id">kepala terasa ringan</skos:altLabel><ns2:comment xml:lang="id">[GejalaEfekSamping] Rekomendasi: TanyaApoteker. Sensasi ketidakseimbangan atau kepala ringan akibat efek vaskular atau sedasi obat flu.</ns2:comment><skos:note xml:lang="id">Sinonim awam adalah draf dan perlu validasi apoteker.</skos:note></ns1:Class>
    <ns1:Axiom>
        <ns1:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000610" />
        <ns1:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115" />
        <ns1:annotatedTarget>A  balance symptom that is characterized by a sensation of unsteadiness accompanied by a feeling of movement within the head.</ns1:annotatedTarget>
        <oboInOwl:hasDbXref>url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=dizziness</oboInOwl:hasDbXref>
    </ns1:Axiom>
    


    

    <ns1:Class rdf:about="http://purl.obolibrary.org/obo/SYMP_0000613">
        <ns2:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000410" />
        <obo:IAO_0000115>A neurological and physiological symptom that is characterized by a rise of body temperature above the normal, whether as a natural response (as to infection) or artificially induced for therapeutic reasons.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD9CM_2005:780.6</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0015967</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_ICD9CM_2005_AUI:A0058972</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>pyrexia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0000613</oboInOwl:id>
        <ns2:label>fever</ns2:label>
    <skos:altLabel xml:lang="id">Demam / suhu tubuh meningkat</skos:altLabel><skos:altLabel xml:lang="id">panas</skos:altLabel><skos:altLabel xml:lang="id">badan panas</skos:altLabel><ns2:comment xml:lang="id">[GejalaIndikasi] Rekomendasi: Pantau. Peningkatan suhu tubuh di atas normal akibat respon sitokin pirogen (indikasi antipiretik).</ns2:comment><skos:note xml:lang="id">Sinonim awam adalah draf dan perlu validasi apoteker.</skos:note></ns1:Class>
    <ns1:Axiom>
        <ns1:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000613" />
        <ns1:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115" />
        <ns1:annotatedTarget>A neurological and physiological symptom that is characterized by a rise of body temperature above the normal, whether as a natural response (as to infection) or artificially induced for therapeutic reasons.</ns1:annotatedTarget>
        <oboInOwl:hasDbXref>url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=fever</oboInOwl:hasDbXref>
    </ns1:Axiom>
    


    

    <ns1:Class rdf:about="http://purl.obolibrary.org/obo/SYMP_0000614">
        <ns2:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000514" />
        <obo:IAO_0000115>A respiratory system and chest symptom that is characterized by an explosive expulsion of air from the lungs acting as a protective mechanism to clear the air passages or as a symptom of pulmonary disturbance.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD9CM_2005:786.2</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0010200</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_ICD9CM_2005_AUI:A0043303</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0000614</oboInOwl:id>
        <ns2:label>cough</ns2:label>
    <skos:altLabel xml:lang="id">Batuk</skos:altLabel><skos:altLabel xml:lang="id">batuk-batuk</skos:altLabel><ns2:comment xml:lang="id">[GejalaIndikasi] Rekomendasi: Pantau. Refleks pertahanan saluran napas untuk membersihkan sekret atau iritan.</ns2:comment><skos:note xml:lang="id">Sinonim awam adalah draf dan perlu validasi apoteker.</skos:note></ns1:Class>
    <ns1:Axiom>
        <ns1:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000614" />
        <ns1:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115" />
        <ns1:annotatedTarget>A respiratory system and chest symptom that is characterized by an explosive expulsion of air from the lungs acting as a protective mechanism to clear the air passages or as a symptom of pulmonary disturbance.</ns1:annotatedTarget>
        <oboInOwl:hasDbXref>url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=cough</oboInOwl:hasDbXref>
    </ns1:Axiom>
    


    

    <ns1:Class rdf:about="http://purl.obolibrary.org/obo/SYMP_0000869">
        <ns2:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000237" />
        <obo:IAO_0000115>A congestion that is characterized by a blockage of the nasal passages, usually due to the membranes lining the nose becoming swollen from inflamed blood vessels.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0000869</oboInOwl:id>
        <ns2:label>nasal congestion</ns2:label>
    <skos:altLabel xml:lang="id">Hidung tersumbat</skos:altLabel><skos:altLabel xml:lang="id">hidung mampet</skos:altLabel><skos:altLabel xml:lang="id">hidung buntu</skos:altLabel><ns2:comment xml:lang="id">[GejalaIndikasi] Rekomendasi: Pantau. Penyumbatan rongga hidung akibat pembengkakan mukosa vaskular (indikasi dekongestan).</ns2:comment><skos:note xml:lang="id">Sinonim awam adalah draf dan perlu validasi apoteker.</skos:note></ns1:Class>
    <ns1:Axiom>
        <ns1:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000869" />
        <ns1:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115" />
        <ns1:annotatedTarget>A congestion that is characterized by a blockage of the nasal passages, usually due to the membranes lining the nose becoming swollen from inflamed blood vessels.</ns1:annotatedTarget>
        <oboInOwl:hasDbXref>url:http://en.wikipedia.org/wiki/Nasal_congestion</oboInOwl:hasDbXref>
    </ns1:Axiom>
    


    

    <ns1:Class rdf:about="http://purl.obolibrary.org/obo/SYMP_0000892">
        <ns2:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000480" />
        <obo:IAO_0000115>A nervous system symptom that is characterized by interpretation of the information perceived by sensory receptors.</obo:IAO_0000115>
        <oboInOwl:created_by>lschriml</oboInOwl:created_by>
        <oboInOwl:creation_date>2010-10-15T11:54:30Z</oboInOwl:creation_date>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0000892</oboInOwl:id>
        <ns2:label>sensation perception</ns2:label>
    </ns1:Class>
    <ns1:Axiom>
        <ns1:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000892" />
        <ns1:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115" />
        <ns1:annotatedTarget>A nervous system symptom that is characterized by interpretation of the information perceived by sensory receptors.</ns1:annotatedTarget>
        <oboInOwl:hasDbXref>url:http://www.audiblox2000.com/sensation-perception.htm</oboInOwl:hasDbXref>
    </ns1:Axiom>
    


    

    <ns1:Class rdf:about="http://purl.obolibrary.org/obo/SYMP_0019145">
        <ns2:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000459" />
        <obo:IAO_0000115>Vomiting is a digestive system symptom characterized by throwing up the stomach contents.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>emesis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0019145</oboInOwl:id>
        <ns2:label>vomiting</ns2:label>
    <skos:altLabel xml:lang="id">Muntah</skos:altLabel><skos:altLabel xml:lang="id">muntah-muntah</skos:altLabel><ns2:comment xml:lang="id">[GejalaEfekSamping] Rekomendasi: TanyaApoteker. Pengeluaran isi lambung paksa; bila berulang hentikan konsumsi obat dan konsultasi apoteker.</ns2:comment><skos:note xml:lang="id">Sinonim awam adalah draf dan perlu validasi apoteker.</skos:note></ns1:Class>
    <ns1:Axiom>
        <ns1:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0019145" />
        <ns1:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115" />
        <ns1:annotatedTarget>Vomiting is a digestive system symptom characterized by throwing up the stomach contents.</ns1:annotatedTarget>
        <oboInOwl:hasDbXref>url:http://www.merriam-webster.com/dictionary/vomiting</oboInOwl:hasDbXref>
    </ns1:Axiom>
    


    

    <ns1:Class rdf:about="http://purl.obolibrary.org/obo/SYMP_0019153">
        <ns2:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000598" />
        <obo:IAO_0000115>A respiratory abnormality that is characterized by difficult or labored respiration.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>breathing difficulty</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>breathlessness</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>difficulty breathing</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>labored respiration</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>shortness of breath</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0019153</oboInOwl:id>
        <ns2:label>dyspnea</ns2:label>
    <skos:altLabel xml:lang="id">Sesak napas / kesulitan bernapas</skos:altLabel><skos:altLabel xml:lang="id">sulit bernapas</skos:altLabel><skos:altLabel xml:lang="id">napas sesak</skos:altLabel><ns2:comment xml:lang="id">[GejalaRedFlag] Rekomendasi: SegeraKeDokter. Tanda bahaya gawat darurat infeksi saluran napas bawah (pneumonia/asma berat); rujuk segera.</ns2:comment><skos:note xml:lang="id">Sinonim awam adalah draf dan perlu validasi apoteker.</skos:note></ns1:Class>
    <ns1:Axiom>
        <ns1:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0019153" />
        <ns1:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115" />
        <ns1:annotatedTarget>A respiratory abnormality that is characterized by difficult or labored respiration.</ns1:annotatedTarget>
        <oboInOwl:hasDbXref>url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=dyspnea</oboInOwl:hasDbXref>
    </ns1:Axiom>
    


    

    <ns1:Class rdf:about="http://purl.obolibrary.org/obo/SYMP_0020027">
        <ns2:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000614" />
        <obo:IAO_0000115>A cough that is characterized by a production and expectoration (bringing up) of mucus (phlegm) or sputum.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>productive cough</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0020027</oboInOwl:id>
        <ns2:label>wet cough</ns2:label>
    <skos:altLabel xml:lang="id">Batuk berdahak / produktif</skos:altLabel><skos:altLabel xml:lang="id">batuk berdahak</skos:altLabel><skos:altLabel xml:lang="id">batuk berlendir</skos:altLabel><ns2:comment xml:lang="id">[GejalaIndikasi] Rekomendasi: Pantau. Batuk disertai dahak kental pada saluran napas (indikasi ekspektoran/mukolitik).</ns2:comment><skos:note xml:lang="id">Sinonim awam adalah draf dan perlu validasi apoteker.</skos:note></ns1:Class>
    <ns1:Axiom>
        <ns1:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0020027" />
        <ns1:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115" />
        <ns1:annotatedTarget>A cough that is characterized by a production and expectoration (bringing up) of mucus (phlegm) or sputum.</ns1:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://www.webmd.com/lung/productive-cough-causes</oboInOwl:hasDbXref>
    </ns1:Axiom>
    


    

    <ns1:Class rdf:about="http://purl.obolibrary.org/obo/SYMP_0020043">
        <ns2:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000486" />
        <obo:IAO_0000115>A urinary system symptom that is characterized by an elevation in the concentration of the the pigments from foods, dyes, and medications in urine. The dilution of these pigment is dependent on the amount of water intake and severe dehydration can lead to a dark color.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0020043</oboInOwl:id>
        <ns2:label>dark urine</ns2:label>
    <skos:altLabel xml:lang="id">Urin berwarna gelap pekat seperti teh</skos:altLabel><skos:altLabel xml:lang="id">air kencing gelap</skos:altLabel><skos:altLabel xml:lang="id">kencing seperti teh</skos:altLabel><ns2:comment xml:lang="id">[GejalaRedFlag] Rekomendasi: SegeraKeDokter. Tanda toksisitas mioglobinuria/rhabdomyolysis atau hepatotoksisitas berat akibat interaksi obat.</ns2:comment><skos:note xml:lang="id">Sinonim awam adalah draf dan perlu validasi apoteker.</skos:note></ns1:Class>
    <ns1:Axiom>
        <ns1:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0020043" />
        <ns1:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115" />
        <ns1:annotatedTarget>A urinary system symptom that is characterized by an elevation in the concentration of the the pigments from foods, dyes, and medications in urine. The dilution of these pigment is dependent on the amount of water intake and severe dehydration can lead to a dark color.</ns1:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://www.mayoclinic.org/diseases-conditions/urine-color/symptoms-causes/syc-20367333</oboInOwl:hasDbXref>
    </ns1:Axiom>
    


    

    <ns1:Class rdf:about="http://purl.obolibrary.org/obo/SYMP_0020045">
        <ns2:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000410" />
        <obo:IAO_0000115>A neurological and physiological symptom that is characterized by any of the following: dizziness or vertigo (a spinning sensation); falling or feeling as if you are going to fall; staggering when walking; lightheadedness, faintness, or a floating sensation; and confusion or disorientation.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0020045</oboInOwl:id>
        <ns2:label>balance symptom</ns2:label>
    </ns1:Class>
    <ns1:Axiom>
        <ns1:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0020045" />
        <ns1:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115" />
        <ns1:annotatedTarget>A neurological and physiological symptom that is characterized by any of the following: dizziness or vertigo (a spinning sensation); falling or feeling as if you are going to fall; staggering when walking; lightheadedness, faintness, or a floating sensation; and confusion or disorientation.</ns1:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://www.nidcd.nih.gov/health/balance-disorders</oboInOwl:hasDbXref>
    </ns1:Axiom>
<ns1:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#altLabel" /><ns1:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#note" /></rdf:RDF>