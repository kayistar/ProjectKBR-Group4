    <ns1:Class rdf:about="http://purl.obolibrary.org/obo/SYMP_0000458">
        <ns2:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000459" />
        <obo:IAO_0000115>Nausea is a digestive system symptom characterized by an uneasy or unsettled feeling in the stomach together with an urge to vomit.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD9CM_2005:787.02</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0375548</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_ICD9CM_2005_AUI:A0750850</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0000458</oboInOwl:id>
        <ns2:label>nausea</ns2:label>
    <skos:altLabel xml:lang="id">Mual / eneg di ulu hati</skos:altLabel><skos:altLabel xml:lang="id">mual</skos:altLabel><skos:altLabel xml:lang="id">eneg</skos:altLabel><ns2:comment xml:lang="id">[GejalaEfekSamping] Rekomendasi: Pantau. Iritasi mukosa lambung akibat obat ekspektoran (Guaifenesin) atau analgesik (Ibuprofen).</ns2:comment><skos:note xml:lang="id">Sinonim awam adalah draf dan perlu validasi apoteker.</skos:note></ns1:Class>
    <ns1:Axiom>
        <ns1:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000458" />
        <ns1:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115" />
        <ns1:annotatedTarget>Nausea is a digestive system symptom characterized by an uneasy or unsettled feeling in the stomach together with an urge to vomit.</ns1:annotatedTarget>
        <oboInOwl:hasDbXref>url:http://www.nlm.nih.gov/medlineplus/nauseaandvomiting.html</oboInOwl:hasDbXref>
    </ns1:Axiom>
    


    

    <ns1:Class rdf:about="http://purl.obolibrary.org/obo/SYMP_0000459">
        <ns2:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000462" />
        <oboInOwl:hasDbXref>ICD9CM_2005:787</oboInOwl:hasDbXref>
