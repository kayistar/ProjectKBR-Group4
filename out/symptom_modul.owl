    </ns1:Class>
    


    

    <ns1:Class rdf:about="http://purl.obolibrary.org/obo/SYMP_0000388">
        <ns2:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000387" />
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0000388</oboInOwl:id>
        <ns2:label>nose symptom</ns2:label>
    </ns1:Class>
    


    

    <ns1:Class rdf:about="http://purl.obolibrary.org/obo/SYMP_0000410">
        <ns2:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000462" />
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0000410</oboInOwl:id>
