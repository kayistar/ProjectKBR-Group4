        <oboInOwl:hasDbXref>ICD9CM_2005:781</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0159033</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_ICD9CM_2005_AUI:A0284131</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0000480</oboInOwl:id>
        <ns2:label>nervous system symptom</ns2:label>
    </ns1:Class>
    


    

    <ns1:Class rdf:about="http://purl.obolibrary.org/obo/SYMP_0000486">
        <ns2:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000462" />
        <oboInOwl:hasDbXref>ICD9CM_2005:788</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0476293</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_ICD9CM_2005_AUI:A0284245</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0000486</oboInOwl:id>
        <ns2:label>urinary system symptom</ns2:label>
    </ns1:Class>
    


    

    <ns1:Class rdf:about="http://purl.obolibrary.org/obo/SYMP_0000504">
        <ns2:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000099" />
        <obo:IAO_0000115>A pain that is characterized by a pain in the head.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD9CM_2005:784.0</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0018681</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_ICD9CM_2005_AUI:A0065994</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>cephalalgia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0000504</oboInOwl:id>
        <ns2:label>headache</ns2:label>
    <skos:altLabel xml:lang="id">Sakit kepala / pening</skos:altLabel><skos:altLabel xml:lang="id">kepala sakit</skos:altLabel><ns2:comment xml:lang="id">[GejalaIndikasi] Rekomendasi: Pantau. Nyeri tumpul atau berdenyut pada area kepala yang menyertai sindrom influenza/ISPA.</ns2:comment><skos:note xml:lang="id">Sinonim awam adalah draf dan perlu validasi apoteker.</skos:note></ns1:Class>
    <ns1:Axiom>
        <ns1:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000504" />
        <ns1:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115" />
        <ns1:annotatedTarget>A pain that is characterized by a pain in the head.</ns1:annotatedTarget>
        <oboInOwl:hasDbXref>url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=headache</oboInOwl:hasDbXref>
    </ns1:Axiom>
    


    

    <ns1:Class rdf:about="http://purl.obolibrary.org/obo/SYMP_0000505">
        <ns2:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000099" />
        <obo:IAO_0000115>A pain that is characterized by a painful throat due to inflammation of the fauces and pharynx.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD9CM_2005:784.1</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0242429</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_ICD9CM_2005_AUI:A0284175</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>sore throat</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0000505</oboInOwl:id>
        <ns2:label>throat pain</ns2:label>
    <skos:altLabel xml:lang="id">Sakit tenggorokan / nyeri menelan</skos:altLabel><skos:altLabel xml:lang="id">tenggorokan sakit</skos:altLabel><skos:altLabel xml:lang="id">sakit saat menelan</skos:altLabel><ns2:comment xml:lang="id">[GejalaIndikasi] Rekomendasi: Pantau. Rasa nyeri atau iritasi pada faring/laring yang sering menyertai infeksi flu saluran napas atas.</ns2:comment><skos:note xml:lang="id">Sinonim awam adalah draf dan perlu validasi apoteker.</skos:note></ns1:Class>
    <ns1:Axiom>
        <ns1:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000505" />
        <ns1:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115" />
        <ns1:annotatedTarget>A pain that is characterized by a painful throat due to inflammation of the fauces and pharynx.</ns1:annotatedTarget>
        <oboInOwl:hasDbXref>url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=sore%20throat</oboInOwl:hasDbXref>
    </ns1:Axiom>
    


    

    <ns1:Class rdf:about="http://purl.obolibrary.org/obo/SYMP_0000514">
