        <oboInOwl:hasDbXref>UMLS_ICD9CM_2005_AUI:A0284192</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0000528</oboInOwl:id>
        <ns2:label>cardiovascular system symptom</ns2:label>
    </ns1:Class>
    


    

    <ns1:Class rdf:about="http://purl.obolibrary.org/obo/SYMP_0000529">
        <ns2:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000287" />
        <obo:IAO_0000115>Tachycardia is a cardiovascular system symptom consisting of a relatively rapid heart action whether physiological (as after exercise) or pathological.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD9CM_2005:785.0</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0039231</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_ICD9CM_2005_AUI:A0804597</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0000529</oboInOwl:id>
        <ns2:label>tachycardia</ns2:label>
    <skos:altLabel xml:lang="id">Denyut jantung terlalu cepat</skos:altLabel><skos:altLabel xml:lang="id">denyut jantung cepat</skos:altLabel><skos:altLabel xml:lang="id">jantung berdetak cepat</skos:altLabel><ns2:comment xml:lang="id">[GejalaEfekSamping] Rekomendasi: TanyaApoteker. Frekuensi nadi istirahat &gt;100 bpm; risiko meningkat bila dekongestan dikombinasikan dengan kafein.</ns2:comment><skos:note xml:lang="id">Sinonim awam adalah draf dan perlu validasi apoteker.</skos:note></ns1:Class>
    <ns1:Axiom>
        <ns1:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000529" />
        <ns1:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115" />
        <ns1:annotatedTarget>Tachycardia is a cardiovascular system symptom consisting of a relatively rapid heart action whether physiological (as after exercise) or pathological.</ns1:annotatedTarget>
        <oboInOwl:hasDbXref>url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=tachycardia</oboInOwl:hasDbXref>
    </ns1:Axiom>
    


    

    <ns1:Class rdf:about="http://purl.obolibrary.org/obo/SYMP_0000530">
        <ns2:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000528" />
        <obo:IAO_0000115>Palpitation is a cardiovascykar system symptom characterized by an abnormal awareness of the beating of the heart,whether it is too slow, too fast, irregular, or at its normal frequency when excited by violent exertion, strong emotion, or disease.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD9CM_2005:785.1</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0030252</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_ICD9CM_2005_AUI:A0004066</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>abnormal heart beats</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0000530</oboInOwl:id>
        <ns2:label>palpitation</ns2:label>
    <skos:altLabel xml:lang="id">Jantung berdebar-debar</skos:altLabel><skos:altLabel xml:lang="id">deg-degan</skos:altLabel><skos:altLabel xml:lang="id">jantung terasa berdebar</skos:altLabel><ns2:comment xml:lang="id">[GejalaEfekSamping] Rekomendasi: TanyaApoteker. Sensasi denyut jantung cepat/kuat akibat stimulasi adrenergik alfa/beta dari dekongestan.</ns2:comment><skos:note xml:lang="id">Sinonim awam adalah draf dan perlu validasi apoteker.</skos:note></ns1:Class>
    <ns1:Axiom>
        <ns1:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000530" />
        <ns1:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115" />
        <ns1:annotatedTarget>Palpitation is a cardiovascykar system symptom characterized by an abnormal awareness of the beating of the heart,whether it is too slow, too fast, irregular, or at its normal frequency when excited by violent exertion, strong emotion, or disease.</ns1:annotatedTarget>
        <oboInOwl:hasDbXref>url:http://en.wikipedia.org/wiki/Palpitation</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=palpitation</oboInOwl:hasDbXref>
    </ns1:Axiom>
    


    

    <ns1:Class rdf:about="http://purl.obolibrary.org/obo/SYMP_0000557">
        <ns2:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000486" />
        <obo:IAO_0000115>A urinary system symptom that is characterized by an inability to empty the bladder completely during the process of voiding (urination).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD9CM_2005:788.2</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM_2005:788.20</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0080274</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_ICD9CM_2005_AUI:A0284250</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_ICD9CM_2005_AUI:A0784422</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>inability to urinate</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ischuria</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>retention of urine</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0000557</oboInOwl:id>
        <ns2:label>urinary retention</ns2:label>
    <skos:altLabel xml:lang="id">Sulit buang air kecil / retensi urin</skos:altLabel><skos:altLabel xml:lang="id">susah kencing</skos:altLabel><skos:altLabel xml:lang="id">sulit kencing</skos:altLabel><ns2:comment xml:lang="id">[GejalaEfekSamping] Rekomendasi: TanyaApoteker. Hambatan pengosongan kandung kemih karena efek antikolinergik (waspada pasien BPH/prostat).</ns2:comment><skos:note xml:lang="id">Sinonim awam adalah draf dan perlu validasi apoteker.</skos:note></ns1:Class>
    <ns1:Axiom>
        <ns1:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000557" />
        <ns1:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115" />
        <ns1:annotatedTarget>A urinary system symptom that is characterized by an inability to empty the bladder completely during the process of voiding (urination).</ns1:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://en.wikipedia.org/wiki/Urinary_retention</oboInOwl:hasDbXref>
    </ns1:Axiom>
    


    

    <ns1:Class rdf:about="http://purl.obolibrary.org/obo/SYMP_0000576">
        <ns2:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000099" />
        <oboInOwl:hasDbXref>ICD9CM_2005:786.5</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM_2005:786.50</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0008031</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_ICD9CM_2005_AUI:A0243830</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_ICD9CM_2005_AUI:A0400627</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0000576</oboInOwl:id>
        <ns2:label>chest pain</ns2:label>
    <skos:altLabel xml:lang="id">Nyeri dada / dada terasa tertekan</skos:altLabel><skos:altLabel xml:lang="id">dada sakit</skos:altLabel><skos:altLabel xml:lang="id">dada terasa tertekan</skos:altLabel><ns2:comment xml:lang="id">[GejalaRedFlag] Rekomendasi: SegeraKeDokter. Nyeri atau rasa sesak berat di dada; perlu disingkirkan komplikasi kardiovaskular/pleuritis.</ns2:comment><skos:note xml:lang="id">Sinonim awam adalah draf dan perlu validasi apoteker.</skos:note></ns1:Class>
    


    

    <ns1:Class rdf:about="http://purl.obolibrary.org/obo/SYMP_0000587">
        <ns2:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000514" />
        <obo:IAO_0000115>A respiratory system and chest symptom that is characterized by a sound of breathing that is not similar to that of the sound of moving air and may include: rhonchi (a low-pitched breath sound), crackles (a high-pitched breath sound), wheezing (a high-pitched whistling sound caused by narrowing of the bronchial tubes), and stridor (a harsh, vibratory sound caused by narrowing of the upper airway).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD9CM_2005:786.7</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0159056</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_ICD9CM_2005_AUI:A0284219</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0000587</oboInOwl:id>
        <ns2:label>abnormal chest sound</ns2:label>
    </ns1:Class>
    <ns1:Axiom>
        <ns1:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000587" />
        <ns1:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115" />
        <ns1:annotatedTarget>A respiratory system and chest symptom that is characterized by a sound of breathing that is not similar to that of the sound of moving air and may include: rhonchi (a low-pitched breath sound), crackles (a high-pitched breath sound), wheezing (a high-pitched whistling sound caused by narrowing of the bronchial tubes), and stridor (a harsh, vibratory sound caused by narrowing of the upper airway).</ns1:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://www.healthline.com/health/breath-sounds#types</oboInOwl:hasDbXref>
    </ns1:Axiom>
    


    

    <ns1:Class rdf:about="http://purl.obolibrary.org/obo/SYMP_0000597">
        <ns2:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000462" />
        <oboInOwl:hasDbXref>ICD9CM_2005:784</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0476247</oboInOwl:hasDbXref>
