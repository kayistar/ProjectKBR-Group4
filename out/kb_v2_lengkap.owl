        <chemrof:mass rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">259.45</chemrof:mass>
        <chemrof:monoisotopic_mass rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">259.24258</chemrof:monoisotopic_mass>
