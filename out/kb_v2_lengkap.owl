    <!-- http://purl.obolibrary.org/obo/CHEBI_10545 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_10545">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_36338"/>
        <obo:IAO_0000115>Elementary particle not affected by the strong force having a spin ½, a negative elementary charge and a rest mass of 0.000548579903(13) u, or 0.51099906(15) MeV.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>kegg.compound:C05359</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>pubmed:21614077</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>wikipedia.en:Electron</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:10545</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/chebi/3_STAR"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/chebi.owl"/>
        <rdfs:label>electron</rdfs:label>
        <chemrof:charge rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-1</chemrof:charge>
        <chemrof:mass rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.001</chemrof:mass>
        <chemrof:monoisotopic_mass rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.0</chemrof:monoisotopic_mass>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHEBI_10545"/>
