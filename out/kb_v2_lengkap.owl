    <!-- http://purl.obolibrary.org/obo/CHEBI_58951 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_58951">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_28868"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0018033"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_26666"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Any fatty acid anion obtained by removal of a proton from the carboxy group of a short-chain fatty acid (chain length of less than C&lt;small&gt;&lt;sub&gt;6&lt;/sub&gt;&lt;/small&gt;).</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:58951</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/chebi/3_STAR"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/chebi.owl"/>
        <rdfs:label>short-chain fatty acid anion</rdfs:label>
        <chemrof:charge rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-1</chemrof:charge>
        <chemrof:generalized_empirical_formula>CO2R</chemrof:generalized_empirical_formula>
        <chemrof:mass rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">44.01</chemrof:mass>
        <chemrof:monoisotopic_mass rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">43.98983</chemrof:monoisotopic_mass>
        <chemrof:smiles_string>*C(=O)[O-]</chemrof:smiles_string>
    </owl:Class>
    


