        <chemrof:monoisotopic_mass rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">44.99765</chemrof:monoisotopic_mass>
        <chemrof:smiles_string>*C(=O)O</chemrof:smiles_string>
