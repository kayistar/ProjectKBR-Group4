    <!-- http://purl.obolibrary.org/obo/CHEBI_100241 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/CHEBI_100241">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/CHEBI_100241"/>
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#ZatAktif"/>
        <kbr:kontraindikasiBagi rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#AnakBawah2Tahun"/>
        <kbr:kontraindikasiBagi rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#Kehamilan"/>
        <kbr:kontraindikasiBagi rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#Menyusui"/>
        <kbr:memilikiInteraksiDengan rdf:resource="http://purl.obolibrary.org/obo/CHEBI_5383"/>
        <kbr:memilikiKelasATC4 rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#atc4_J01MA"/>
        <kbr:menghasilkanInteraksi rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#int_INT-016"/>
        <kbr:perluHatiHatiBagi rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#DiabetesMelitus"/>
        <kbr:perluHatiHatiBagi rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#GangguanGinjalBerat"/>
        <kbr:perluHatiHatiBagi rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#Lansia65Plus"/>
        <kbr:aksiBawahBatas>Antibiotik resep dokter</kbr:aksiBawahBatas>
        <kbr:bbMinSwamedikasi>ResepDokter</kbr:bbMinSwamedikasi>
        <kbr:chebiID>CHEBI:100241</kbr:chebiID>
        <kbr:dosisAnak>Hanya atas indikasi khusus dokter</kbr:dosisAnak>
        <kbr:dosisDewasa>250-750 mg tiap 12 jam</kbr:dosisDewasa>
        <kbr:dosisMgPerKg>Dosis dewasa tetap (anak hanya indikasi khusus)</kbr:dosisMgPerKg>
        <kbr:frekuensiMinum>2 kali sehari</kbr:frekuensiMinum>
        <kbr:gejalaAlergi>Urtikaria, angioedema, sesak napas, syok anafilaksis, fotosensitivitas</kbr:gejalaAlergi>
        <kbr:golonganAlergen>Antibiotik Fluorokuinolon</kbr:golonganAlergen>
        <kbr:kodeATC>J01MA02</kbr:kodeATC>
        <kbr:kodeATC4>J01MA</kbr:kodeATC4>
        <kbr:kodeHubunganMakan>BebasMakan_JedaSusu</kbr:kodeHubunganMakan>
        <kbr:kutipanSumberAlergi>CONTRAINDICATIONS A history of hypersensitivity to ciprofloxacin or any other component of the medication is a contraindication to its use. A history of hypersensitivity to other quinolones may also contraindicate the use of ciprofloxacin.</kbr:kutipanSumberAlergi>
        <kbr:maksDosisHarian>1500 mg/hari</kbr:maksDosisHarian>
        <kbr:maksHariSwamedikasi>Sesuai resep dokter (harus habis)</kbr:maksHariSwamedikasi>
        <kbr:pantanganMakanan>Susu, yogurt, suplemen kalsium/zat besi/zinc dalam 2 jam; kafein berlebih</kbr:pantanganMakanan>
        <kbr:pemicuAlergiSilang>Levofloxacin; Ofloxacin; Moxifloxacin (seluruh kelas kuinolon)</kbr:pemicuAlergiSilang>
        <kbr:peringatanKhusus>ANTIBIOTIK RESEP. Wajib dihabiskan sesuai durasi resep dokter.</kbr:peringatanKhusus>
        <kbr:urlSumberAlergi>https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=05b2836d-cd3d-4d7f-970c-66ec2d788667</kbr:urlSumberAlergi>
        <kbr:usiaMinSwamedikasi>ResepDokter</kbr:usiaMinSwamedikasi>
        <kbr:waktuMinumTeks>Bebas makan; beri jeda 2 jam sebelum atau 4-6 jam sesudah susu/antasida/mineral</kbr:waktuMinumTeks>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_10033 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/CHEBI_10033">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/CHEBI_10033"/>
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#ZatAktif"/>
        <kbr:dimetabolismeOleh rdf:resource="http://purl.obolibrary.org/obo/PR_P08684"/>
        <kbr:dimetabolismeOleh rdf:resource="http://purl.obolibrary.org/obo/PR_P11712"/>
        <kbr:kontraindikasiBagi rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#AnakBawah2Tahun"/>
        <kbr:kontraindikasiBagi rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#GangguanHatiBerat"/>
        <kbr:kontraindikasiBagi rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#HipertensiTidakTerkontrol"/>
        <kbr:kontraindikasiBagi rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#Kehamilan"/>
        <kbr:kontraindikasiBagi rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#TukakLambungGERD"/>
        <kbr:memilikiKelasATC4 rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#atc4_B01AA"/>
        <kbr:perluHatiHatiBagi rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#GangguanGinjalBerat"/>
        <kbr:perluHatiHatiBagi rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#Lansia65Plus"/>
        <kbr:aksiBawahBatas>Obat keras / resep dokter</kbr:aksiBawahBatas>
        <kbr:bbMinSwamedikasi>ResepDokter</kbr:bbMinSwamedikasi>
        <kbr:chebiID>CHEBI:10033</kbr:chebiID>
        <kbr:dosisAnak>Sesuai resep dokter</kbr:dosisAnak>
        <kbr:dosisDewasa>Disesuaikan target INR (umumnya 2-10 mg/hari)</kbr:dosisDewasa>
        <kbr:dosisMgPerKg>Dosis titrasi target INR (resep dokter)</kbr:dosisMgPerKg>
        <kbr:frekuensiMinum>1 kali sehari</kbr:frekuensiMinum>
        <kbr:gejalaAlergi>Ruam kulit, urtikaria, nekrosis kulit terkait warfarin (jarang)</kbr:gejalaAlergi>
        <kbr:golonganAlergen>Antikoagulan Antagonis Vitamin K</kbr:golonganAlergen>
        <kbr:kodeATC>B01AA03</kbr:kodeATC>
        <kbr:kodeATC4>B01AA</kbr:kodeATC4>
        <kbr:kodeHubunganMakan>BebasMakan</kbr:kodeHubunganMakan>
        <kbr:kutipanSumberAlergi>Warfarin sodium is contraindicated in patients with: Hemorrhagic tendencies or blood dyscrasias Recent or contemplated surgery of the central nervous system or eye, or traumatic surgery resulting in large open surfaces [see Warnings and Precautions ( 5.8 )] Bleeding tendencies associated with: − Active ulceration or overt bleeding of the gastrointestinal, genitourinary, or respiratory tract − Central nervous system h</kbr:kutipanSumberAlergi>
        <kbr:maksDosisHarian>Sesuai pemantauan INR</kbr:maksDosisHarian>
        <kbr:maksHariSwamedikasi>Obat rutin (sesuai resep dokter)</kbr:maksHariSwamedikasi>
        <kbr:pantanganMakanan>Sayuran hijau tinggi vitamin K secara fluktuatif; alkohol; suplemen jahe/kunyit/bawang putih dosis tinggi</kbr:pantanganMakanan>
        <kbr:pemicuAlergiSilang>Acenocoumarol; derivat kumarin lain</kbr:pemicuAlergiSilang>
        <kbr:peringatanKhusus>OBAT RESEP INDEKS TERAPI SEMPIT. Waspadai perdarahan gusi, memar, atau BAB hitam.</kbr:peringatanKhusus>
        <kbr:urlSumberAlergi>https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=0cbce382-9c88-4f58-ae0f-532a841e8f95</kbr:urlSumberAlergi>
        <kbr:usiaMinSwamedikasi>ResepDokter</kbr:usiaMinSwamedikasi>
        <kbr:waktuMinumTeks>Jam yang sama setiap hari; bebas makan</kbr:waktuMinumTeks>
    </owl:NamedIndividual>
    


