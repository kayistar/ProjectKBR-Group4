        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000458"/>
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#GejalaEfekSamping"/>
        <kbr:membutuhkanTindakLanjut rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#TanyaApoteker"/>
        <kbr:alasanRujukGejala>Mual menetap &gt;2 hari setelah minum mukolitik/NSAID perlu evaluasi penghentian/penggantian obat.</kbr:alasanRujukGejala>
        <kbr:batasHariGejala rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</kbr:batasHariGejala>
        <kbr:deskripsiAwam>Iritasi mukosa lambung akibat obat ekspektoran (Guaifenesin) atau analgesik (Ibuprofen).</kbr:deskripsiAwam>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/SYMP_0000504 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/SYMP_0000504">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000504"/>
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#GejalaIndikasi"/>
        <kbr:membutuhkanTindakLanjut rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#SegeraKeDokter"/>
        <kbr:alasanRujukGejala>Sakit kepala berulang &gt;3 hari atau makin berat perlu evaluasi medis.</kbr:alasanRujukGejala>
        <kbr:batasHariGejala rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</kbr:batasHariGejala>
        <kbr:deskripsiAwam>Nyeri tumpul atau berdenyut pada area kepala yang menyertai sindrom influenza/ISPA.</kbr:deskripsiAwam>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/SYMP_0000505 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/SYMP_0000505">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000505"/>
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#GejalaIndikasi"/>
        <kbr:membutuhkanTindakLanjut rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#SegeraKeDokter"/>
        <kbr:alasanRujukGejala>Nyeri tenggorokan berat &gt;3 hari disertai demam atau sulit menelan butuh pemeriksaan faringitis.</kbr:alasanRujukGejala>
        <kbr:batasHariGejala rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</kbr:batasHariGejala>
        <kbr:deskripsiAwam>Rasa nyeri atau iritasi pada faring/laring yang sering menyertai infeksi flu saluran napas atas.</kbr:deskripsiAwam>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/SYMP_0000529 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/SYMP_0000529">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000529"/>
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#GejalaEfekSamping"/>
        <kbr:membutuhkanTindakLanjut rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#SegeraKeDokter"/>
        <kbr:alasanRujukGejala>Takikardia (&gt;100 bpm) berisiko komplikasi kardiovaskular; butuh evaluasi medis segera.</kbr:alasanRujukGejala>
        <kbr:batasHariGejala rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</kbr:batasHariGejala>
        <kbr:deskripsiAwam>Frekuensi nadi istirahat &gt;100 bpm; risiko meningkat bila dekongestan dikombinasikan dengan kafein.</kbr:deskripsiAwam>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/SYMP_0000530 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/SYMP_0000530">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000530"/>
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#GejalaEfekSamping"/>
        <kbr:membutuhkanTindakLanjut rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#SegeraKeDokter"/>
        <kbr:alasanRujukGejala>Jantung berdebar setelah minum dekongestan harus segera hentikan obat &amp; cek nadi/tensi.</kbr:alasanRujukGejala>
        <kbr:batasHariGejala rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</kbr:batasHariGejala>
        <kbr:deskripsiAwam>Sensasi denyut jantung cepat/kuat akibat stimulasi adrenergik alfa/beta dari dekongestan.</kbr:deskripsiAwam>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/SYMP_0000557 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/SYMP_0000557">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000557"/>
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#GejalaEfekSamping"/>
        <kbr:membutuhkanTindakLanjut rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#SegeraKeDokter"/>
        <kbr:alasanRujukGejala>Sulit buang air kecil akut akibat obat flu (terutama BPH) harus hentikan obat &amp; periksa segera.</kbr:alasanRujukGejala>
        <kbr:batasHariGejala rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</kbr:batasHariGejala>
        <kbr:deskripsiAwam>Hambatan pengosongan kandung kemih karena efek antikolinergik (waspada pasien BPH/prostat).</kbr:deskripsiAwam>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/SYMP_0000576 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/SYMP_0000576">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000576"/>
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#GejalaRedFlag"/>
        <kbr:membutuhkanTindakLanjut rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#SegeraKeDokter"/>
        <kbr:alasanRujukGejala>RED FLAG: Nyeri dada harus segera disingkirkan penyebab jantung/pleuritis.</kbr:alasanRujukGejala>
        <kbr:batasHariGejala rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</kbr:batasHariGejala>
        <kbr:deskripsiAwam>Nyeri atau rasa sesak berat di dada; perlu disingkirkan komplikasi kardiovaskular/pleuritis.</kbr:deskripsiAwam>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/SYMP_0000604 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/SYMP_0000604">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000604"/>
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#GejalaRedFlag"/>
        <kbr:membutuhkanTindakLanjut rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#SegeraKeDokter"/>
        <kbr:alasanRujukGejala>RED FLAG: Napas mengi menandakan penyempitan bronkus akut (asma/bronkospasme).</kbr:alasanRujukGejala>
        <kbr:batasHariGejala rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</kbr:batasHariGejala>
        <kbr:deskripsiAwam>Suara napas berfrekuensi tinggi akibat penyempitan lumen bronkus; butuh evaluasi medis.</kbr:deskripsiAwam>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/SYMP_0000610 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/SYMP_0000610">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000610"/>
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#GejalaEfekSamping"/>
        <kbr:membutuhkanTindakLanjut rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#TanyaApoteker"/>
        <kbr:alasanRujukGejala>Pusing melayang akibat obat flu harus segera dievaluasi dosis atau tekanan darahnya.</kbr:alasanRujukGejala>
        <kbr:batasHariGejala rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</kbr:batasHariGejala>
        <kbr:deskripsiAwam>Sensasi ketidakseimbangan atau kepala ringan akibat efek vaskular atau sedasi obat flu.</kbr:deskripsiAwam>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/SYMP_0000613 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/SYMP_0000613">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000613"/>
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#GejalaIndikasi"/>
        <kbr:membutuhkanTindakLanjut rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#SegeraKeDokter"/>
        <kbr:alasanRujukGejala>Demam tidak turun &gt;3 hari (&gt;72 jam) berisiko DBD, tifoid, atau infeksi bakteri sistemik.</kbr:alasanRujukGejala>
        <kbr:batasHariGejala rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</kbr:batasHariGejala>
        <kbr:deskripsiAwam>Peningkatan suhu tubuh di atas normal akibat respon sitokin pirogen (indikasi antipiretik).</kbr:deskripsiAwam>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/SYMP_0000614 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/SYMP_0000614">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000614"/>
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#GejalaIndikasi"/>
        <kbr:membutuhkanTindakLanjut rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#SegeraKeDokter"/>
        <kbr:alasanRujukGejala>Batuk menetap &gt;7 hari berisiko infeksi bakteri/kronis atau efek samping ACE-inhibitor.</kbr:alasanRujukGejala>
        <kbr:batasHariGejala rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</kbr:batasHariGejala>
        <kbr:deskripsiAwam>Refleks pertahanan saluran napas untuk membersihkan sekret atau iritan.</kbr:deskripsiAwam>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/SYMP_0000869 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/SYMP_0000869">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000869"/>
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#GejalaIndikasi"/>
        <kbr:membutuhkanTindakLanjut rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#TanyaApoteker"/>
        <kbr:alasanRujukGejala>Hidung tersumbat &gt;5 hari atau dekongestan tidak mempan berisiko sinusitis/rhinitis medikamentosa.</kbr:alasanRujukGejala>
        <kbr:batasHariGejala rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</kbr:batasHariGejala>
        <kbr:deskripsiAwam>Penyumbatan rongga hidung akibat pembengkakan mukosa vaskular (indikasi dekongestan).</kbr:deskripsiAwam>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/SYMP_0019145 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/SYMP_0019145">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/SYMP_0019145"/>
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#GejalaEfekSamping"/>
        <kbr:membutuhkanTindakLanjut rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#SegeraKeDokter"/>
        <kbr:alasanRujukGejala>Muntah berulang pasca minum obat berisiko dehidrasi dan intoleransi lambung berat.</kbr:alasanRujukGejala>
        <kbr:batasHariGejala rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</kbr:batasHariGejala>
        <kbr:deskripsiAwam>Pengeluaran isi lambung paksa; bila berulang hentikan konsumsi obat dan konsultasi apoteker.</kbr:deskripsiAwam>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/SYMP_0019153 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/SYMP_0019153">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/SYMP_0019153"/>
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#GejalaRedFlag"/>
        <kbr:membutuhkanTindakLanjut rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#SegeraKeDokter"/>
        <kbr:alasanRujukGejala>RED FLAG: Sesak napas merupakan tanda gawat darurat napas bawah, rujuk IGD/dokter segera.</kbr:alasanRujukGejala>
        <kbr:batasHariGejala rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</kbr:batasHariGejala>
        <kbr:deskripsiAwam>Tanda bahaya gawat darurat infeksi saluran napas bawah (pneumonia/asma berat); rujuk segera.</kbr:deskripsiAwam>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/SYMP_0020027 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/SYMP_0020027">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/SYMP_0020027"/>
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#GejalaIndikasi"/>
        <kbr:membutuhkanTindakLanjut rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#SegeraKeDokter"/>
        <kbr:alasanRujukGejala>Batuk berdahak &gt;5 hari atau dahak berubah kuning-hijau kental/demam perlu periksa dokter.</kbr:alasanRujukGejala>
        <kbr:batasHariGejala rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</kbr:batasHariGejala>
        <kbr:deskripsiAwam>Batuk disertai dahak kental pada saluran napas (indikasi ekspektoran/mukolitik).</kbr:deskripsiAwam>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/SYMP_0020043 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/SYMP_0020043">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/SYMP_0020043"/>
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#GejalaRedFlag"/>
        <kbr:membutuhkanTindakLanjut rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#SegeraKeDokter"/>
        <kbr:alasanRujukGejala>RED FLAG: Urin gelap pekat seperti teh menandakan potensi rhabdomyolysis atau hepatotoksisitas.</kbr:alasanRujukGejala>
        <kbr:batasHariGejala rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</kbr:batasHariGejala>
        <kbr:deskripsiAwam>Tanda toksisitas mioglobinuria/rhabdomyolysis atau hepatotoksisitas berat akibat interaksi obat.</kbr:deskripsiAwam>
    </owl:NamedIndividual>
    


