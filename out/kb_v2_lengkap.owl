    <rdf:Description>
        <rdfs:comment xml:lang="id">KasusPasien(?k) ^ memilikiKondisiPasien(?k, HipertensiTidakTerkontrol) ^ memilikiObatPasien(?k, ?op) ^ menggunakanZatAktif(?op, CHEBI_50346) -&gt; membutuhkanTindakLanjut(?k, SegeraKeDokter)</rdfs:comment>
        <rdfs:label xml:lang="id">SWRL-R11: KasusPasien Hipertensi menggunakan Pseudoephedrine -&gt; SegeraKeDokter</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                        <swrl:classPredicate rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#KasusPasien"/>
                        <swrl:argument1 rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#var_k"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#memilikiKondisiPasien"/>
                                <swrl:argument1 rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#var_k"/>
                                <swrl:argument2 rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#HipertensiTidakTerkontrol"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                        <swrl:propertyPredicate rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#memilikiObatPasien"/>
                                        <swrl:argument1 rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#var_k"/>
                                        <swrl:argument2 rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#var_op"/>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                        <rdf:first>
