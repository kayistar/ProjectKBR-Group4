        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0018038"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35366"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A carboxylic ester in which the carboxylic acid component can be any fatty acid.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>CHEBI:27315</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>CHEBI:35747</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>CHEBI:78205</oboInOwl:hasAlternativeId>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:35748</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/chebi/3_STAR"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/chebi.owl"/>
        <rdfs:label>fatty acid ester</rdfs:label>
        <chemrof:charge rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</chemrof:charge>
        <chemrof:generalized_empirical_formula>CO2R2</chemrof:generalized_empirical_formula>
        <chemrof:mass rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">44.01</chemrof:mass>
        <chemrof:monoisotopic_mass rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">43.98983</chemrof:monoisotopic_mass>
        <chemrof:smiles_string>*OC(*)=O</chemrof:smiles_string>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35757 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35757">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_29067"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0018033"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_25384"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A carboxylic acid anion formed when the carboxy group of a monocarboxylic acid is deprotonated.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>CHEBI:13657</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>CHEBI:25382</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>CHEBI:3407</oboInOwl:hasAlternativeId>
