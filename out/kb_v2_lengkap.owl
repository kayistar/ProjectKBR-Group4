    <!-- http://purl.obolibrary.org/obo/CHEBI_38068 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_38068">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_64915"/>
        <obo:IAO_0000115>A drug used in the treatment of malaria. Antimalarials are usually classified on the basis of their action against &lt;em&gt;Plasmodia&lt;/em&gt; at different stages in their life cycle in the human.</obo:IAO_0000115>
