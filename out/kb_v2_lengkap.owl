    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0018034 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0018034">
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
