        <rdfs:label>short-chain fatty acid</rdfs:label>
        <chemrof:charge rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</chemrof:charge>
        <chemrof:generalized_empirical_formula>CH2OR</chemrof:generalized_empirical_formula>
