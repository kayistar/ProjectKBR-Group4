    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SYMP_0000024">
        <obo:IAO_0000115>A neurological and physiological symptom that is characterized by a feeling of being more sleepy than normal during the day. People who are drowsy may fall asleep in when they do not want to or at times which can lead to safety concerns.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>drowsy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>somnolence</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0000024</oboInOwl:id>
        <rdfs:comment xml:lang="id">[GejalaEfekSamping] Rekomendasi: TanyaApoteker. Efek penekanan SSP dari antihistamin generasi pertama (CTM, Diphenhydramine); jangan menyetir.</rdfs:comment>
        <rdfs:label xml:lang="id">Mengantuk / rasa kantuk berat</rdfs:label>
        <rdfs:label>drowsiness</rdfs:label>
        <rdfs:label xml:lang="en">drowsiness</rdfs:label>
        <skos:altLabel xml:lang="id">Mengantuk / rasa kantuk berat</skos:altLabel>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000024"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A neurological and physiological symptom that is characterized by a feeling of being more sleepy than normal during the day. People who are drowsy may fall asleep in when they do not want to or at times which can lead to safety concerns.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://medlineplus.gov/ency/article/003208.htm</oboInOwl:hasDbXref>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SYMP_0000025">
        <obo:IAO_0000115>A cough that is characterized by a lack of accompanied phlegm production.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>nonproductive cough</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0000025</oboInOwl:id>
        <rdfs:comment xml:lang="id">[GejalaIndikasi] Rekomendasi: Pantau. Batuk tanpa produksi dahak/mukus, sering teriritasi di tenggorokan (indikasi antitusif).</rdfs:comment>
        <rdfs:label xml:lang="id">Batuk kering / tidak berdahak</rdfs:label>
        <rdfs:label>dry cough</rdfs:label>
        <rdfs:label xml:lang="en">dry cough</rdfs:label>
        <skos:altLabel xml:lang="id">Batuk kering / tidak berdahak</skos:altLabel>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000025"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>nonproductive cough</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://www.healthline.com/health/dry-cough</oboInOwl:hasDbXref>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SYMP_0000139">
        <obo:IAO_0000115>A respiratory system and chest symptom that is characterized by a sudden violent spasmodic audible expiration of breath through the nose and mouth especially as a reflex act following irritation of the nasal mucous membrane.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0000139</oboInOwl:id>
        <rdfs:comment xml:lang="id">[GejalaIndikasi] Rekomendasi: Pantau. Refleks pengeluaran udara tiba-tiba akibat stimulasi saraf sensorik mukosa hidung.</rdfs:comment>
        <rdfs:label xml:lang="id">Bersin-bersin</rdfs:label>
        <rdfs:label>sneezing</rdfs:label>
        <rdfs:label xml:lang="en">sneezing</rdfs:label>
        <skos:altLabel xml:lang="id">Bersin-bersin</skos:altLabel>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000139"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A respiratory system and chest symptom that is characterized by a sudden violent spasmodic audible expiration of breath through the nose and mouth especially as a reflex act following irritation of the nasal mucous membrane.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=sneezing</oboInOwl:hasDbXref>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SYMP_0000242">
        <obo:IAO_0000115>A cough that is characterized by production and expectoration (bringing up) of sputum that is bright red or pink and frothy.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0000242</oboInOwl:id>
        <rdfs:comment xml:lang="id">[GejalaRedFlag] Rekomendasi: SegeraKeDokter. Hemoptisis; indikasi infeksi parenkim paru serius (mis. TBC, pneumonia berat) bukan batuk biasa.</rdfs:comment>
        <rdfs:label xml:lang="id">Batuk berdarah / dahak bercampur darah</rdfs:label>
        <rdfs:label>cough with bloody sputum</rdfs:label>
        <rdfs:label xml:lang="en">cough with bloody sputum</rdfs:label>
        <skos:altLabel xml:lang="id">Batuk berdarah / dahak bercampur darah</skos:altLabel>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000242"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A cough that is characterized by production and expectoration (bringing up) of sputum that is bright red or pink and frothy.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://www.webmd.com/lung/coughing-up-blood</oboInOwl:hasDbXref>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SYMP_0000260">
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0000260</oboInOwl:id>
        <rdfs:comment xml:lang="id">[GejalaEfekSamping] Rekomendasi: Pantau. Penurunan sekresi saliva akibat blokade reseptor muskarinik perifer oleh antihistamin.</rdfs:comment>
        <rdfs:label xml:lang="id">Mulut kering / haus</rdfs:label>
        <rdfs:label>dry mouth</rdfs:label>
        <rdfs:label xml:lang="en">dry mouth</rdfs:label>
        <skos:altLabel xml:lang="id">Mulut kering / haus</skos:altLabel>
    </rdf:Description>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SYMP_0000372">
        <obo:IAO_0000115>A nose symptom that is characterized by an excessive secretion of mucous through the nose.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>runny nose</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0000372</oboInOwl:id>
        <rdfs:comment xml:lang="id">[GejalaIndikasi] Rekomendasi: Pantau. Keluarnya cairan lendir encer dari rongga hidung (indikasi antihistamin).</rdfs:comment>
        <rdfs:label xml:lang="id">Pilek / hidung berair</rdfs:label>
        <rdfs:label>rhinorrhea</rdfs:label>
        <rdfs:label xml:lang="en">rhinorrhea</rdfs:label>
        <skos:altLabel xml:lang="id">Pilek / hidung berair</skos:altLabel>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000372"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A nose symptom that is characterized by an excessive secretion of mucous through the nose.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=Rhinorrhea</oboInOwl:hasDbXref>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SYMP_0000458">
        <obo:IAO_0000115>Nausea is a digestive system symptom characterized by an uneasy or unsettled feeling in the stomach together with an urge to vomit.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD9CM_2005:787.02</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0375548</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_ICD9CM_2005_AUI:A0750850</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0000458</oboInOwl:id>
        <rdfs:comment xml:lang="id">[GejalaEfekSamping] Rekomendasi: Pantau. Iritasi mukosa lambung akibat obat ekspektoran (Guaifenesin) atau analgesik (Ibuprofen).</rdfs:comment>
        <rdfs:label xml:lang="id">Mual / eneg di ulu hati</rdfs:label>
        <rdfs:label>nausea</rdfs:label>
        <rdfs:label xml:lang="en">nausea</rdfs:label>
        <skos:altLabel xml:lang="id">Mual / eneg di ulu hati</skos:altLabel>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000458"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Nausea is a digestive system symptom characterized by an uneasy or unsettled feeling in the stomach together with an urge to vomit.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:http://www.nlm.nih.gov/medlineplus/nauseaandvomiting.html</oboInOwl:hasDbXref>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SYMP_0000504">
        <obo:IAO_0000115>A pain that is characterized by a pain in the head.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD9CM_2005:784.0</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0018681</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_ICD9CM_2005_AUI:A0065994</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>cephalalgia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0000504</oboInOwl:id>
        <rdfs:comment xml:lang="id">[GejalaIndikasi] Rekomendasi: Pantau. Nyeri tumpul atau berdenyut pada area kepala yang menyertai sindrom influenza/ISPA.</rdfs:comment>
        <rdfs:label xml:lang="id">Sakit kepala / pening</rdfs:label>
        <rdfs:label>headache</rdfs:label>
        <rdfs:label xml:lang="en">headache</rdfs:label>
        <skos:altLabel xml:lang="id">Sakit kepala / pening</skos:altLabel>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000504"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A pain that is characterized by a pain in the head.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=headache</oboInOwl:hasDbXref>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SYMP_0000505">
        <obo:IAO_0000115>A pain that is characterized by a painful throat due to inflammation of the fauces and pharynx.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD9CM_2005:784.1</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0242429</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_ICD9CM_2005_AUI:A0284175</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>sore throat</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0000505</oboInOwl:id>
        <rdfs:comment xml:lang="id">[GejalaIndikasi] Rekomendasi: Pantau. Rasa nyeri atau iritasi pada faring/laring yang sering menyertai infeksi flu saluran napas atas.</rdfs:comment>
        <rdfs:label xml:lang="id">Sakit tenggorokan / nyeri menelan</rdfs:label>
        <rdfs:label>throat pain</rdfs:label>
        <rdfs:label xml:lang="en">throat pain</rdfs:label>
        <skos:altLabel xml:lang="id">Sakit tenggorokan / nyeri menelan</skos:altLabel>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000505"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A pain that is characterized by a painful throat due to inflammation of the fauces and pharynx.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=sore%20throat</oboInOwl:hasDbXref>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SYMP_0000529">
        <obo:IAO_0000115>Tachycardia is a cardiovascular system symptom consisting of a relatively rapid heart action whether physiological (as after exercise) or pathological.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD9CM_2005:785.0</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0039231</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_ICD9CM_2005_AUI:A0804597</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0000529</oboInOwl:id>
        <rdfs:comment xml:lang="id">[GejalaEfekSamping] Rekomendasi: TanyaApoteker. Frekuensi nadi istirahat &gt;100 bpm; risiko meningkat bila dekongestan dikombinasikan dengan kafein.</rdfs:comment>
        <rdfs:label xml:lang="id">Denyut jantung terlalu cepat</rdfs:label>
        <rdfs:label>tachycardia</rdfs:label>
        <rdfs:label xml:lang="en">tachycardia</rdfs:label>
        <skos:altLabel xml:lang="id">Denyut jantung terlalu cepat</skos:altLabel>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000529"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Tachycardia is a cardiovascular system symptom consisting of a relatively rapid heart action whether physiological (as after exercise) or pathological.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=tachycardia</oboInOwl:hasDbXref>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SYMP_0000530">
        <obo:IAO_0000115>Palpitation is a cardiovascykar system symptom characterized by an abnormal awareness of the beating of the heart,whether it is too slow, too fast, irregular, or at its normal frequency when excited by violent exertion, strong emotion, or disease.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD9CM_2005:785.1</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0030252</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_ICD9CM_2005_AUI:A0004066</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>abnormal heart beats</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0000530</oboInOwl:id>
        <rdfs:comment xml:lang="id">[GejalaEfekSamping] Rekomendasi: TanyaApoteker. Sensasi denyut jantung cepat/kuat akibat stimulasi adrenergik alfa/beta dari dekongestan.</rdfs:comment>
        <rdfs:label xml:lang="id">Jantung berdebar-debar</rdfs:label>
        <rdfs:label>palpitation</rdfs:label>
        <rdfs:label xml:lang="en">palpitation</rdfs:label>
        <skos:altLabel xml:lang="id">Jantung berdebar-debar</skos:altLabel>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000530"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Palpitation is a cardiovascykar system symptom characterized by an abnormal awareness of the beating of the heart,whether it is too slow, too fast, irregular, or at its normal frequency when excited by violent exertion, strong emotion, or disease.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:http://en.wikipedia.org/wiki/Palpitation</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=palpitation</oboInOwl:hasDbXref>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SYMP_0000557">
        <obo:IAO_0000115>A urinary system symptom that is characterized by an inability to empty the bladder completely during the process of voiding (urination).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD9CM_2005:788.2</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM_2005:788.20</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0080274</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_ICD9CM_2005_AUI:A0284250</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_ICD9CM_2005_AUI:A0784422</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>inability to urinate</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ischuria</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>retention of urine</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0000557</oboInOwl:id>
        <rdfs:comment xml:lang="id">[GejalaEfekSamping] Rekomendasi: TanyaApoteker. Hambatan pengosongan kandung kemih karena efek antikolinergik (waspada pasien BPH/prostat).</rdfs:comment>
        <rdfs:label xml:lang="id">Sulit buang air kecil / retensi urin</rdfs:label>
        <rdfs:label>urinary retention</rdfs:label>
        <rdfs:label xml:lang="en">urinary retention</rdfs:label>
        <skos:altLabel xml:lang="id">Sulit buang air kecil / retensi urin</skos:altLabel>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000557"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A urinary system symptom that is characterized by an inability to empty the bladder completely during the process of voiding (urination).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://en.wikipedia.org/wiki/Urinary_retention</oboInOwl:hasDbXref>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SYMP_0000576">
        <oboInOwl:hasDbXref>ICD9CM_2005:786.5</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM_2005:786.50</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0008031</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_ICD9CM_2005_AUI:A0243830</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_ICD9CM_2005_AUI:A0400627</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0000576</oboInOwl:id>
        <rdfs:comment xml:lang="id">[GejalaRedFlag] Rekomendasi: SegeraKeDokter. Nyeri atau rasa sesak berat di dada; perlu disingkirkan komplikasi kardiovaskular/pleuritis.</rdfs:comment>
        <rdfs:label xml:lang="id">Nyeri dada / dada terasa tertekan</rdfs:label>
        <rdfs:label>chest pain</rdfs:label>
        <rdfs:label xml:lang="en">chest pain</rdfs:label>
        <skos:altLabel xml:lang="id">Nyeri dada / dada terasa tertekan</skos:altLabel>
    </rdf:Description>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SYMP_0000604">
        <obo:IAO_0000115>An abnormal chest sound that is characterized by breathing with difficulty usually with a whistling sound.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD9CM_2005:786.07</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0043144</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_ICD9CM_2005_AUI:A0133941</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0000604</oboInOwl:id>
        <rdfs:comment xml:lang="id">[GejalaRedFlag] Rekomendasi: SegeraKeDokter. Suara napas berfrekuensi tinggi akibat penyempitan lumen bronkus; butuh evaluasi medis.</rdfs:comment>
        <rdfs:label xml:lang="id">Napas berbunyi mengi / ngik-ngik</rdfs:label>
        <rdfs:label>wheezing</rdfs:label>
        <rdfs:label xml:lang="en">wheezing</rdfs:label>
        <skos:altLabel xml:lang="id">Napas berbunyi mengi / ngik-ngik</skos:altLabel>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000604"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An abnormal chest sound that is characterized by breathing with difficulty usually with a whistling sound.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=wheezing</oboInOwl:hasDbXref>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SYMP_0000610">
        <obo:IAO_0000115>A  balance symptom that is characterized by a sensation of unsteadiness accompanied by a feeling of movement within the head.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD9CM_2005:780.4</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0476206</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_ICD9CM_2005_AUI:A0243727</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>dizzy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0000610</oboInOwl:id>
        <rdfs:comment xml:lang="id">[GejalaEfekSamping] Rekomendasi: TanyaApoteker. Sensasi ketidakseimbangan atau kepala ringan akibat efek vaskular atau sedasi obat flu.</rdfs:comment>
        <rdfs:label xml:lang="id">Pusing / melayang</rdfs:label>
        <rdfs:label>dizziness</rdfs:label>
        <rdfs:label xml:lang="en">dizziness</rdfs:label>
        <skos:altLabel xml:lang="id">Pusing / melayang</skos:altLabel>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000610"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A  balance symptom that is characterized by a sensation of unsteadiness accompanied by a feeling of movement within the head.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=dizziness</oboInOwl:hasDbXref>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SYMP_0000613">
        <obo:IAO_0000115>A neurological and physiological symptom that is characterized by a rise of body temperature above the normal, whether as a natural response (as to infection) or artificially induced for therapeutic reasons.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD9CM_2005:780.6</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0015967</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_ICD9CM_2005_AUI:A0058972</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>pyrexia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0000613</oboInOwl:id>
        <rdfs:comment xml:lang="id">[GejalaIndikasi] Rekomendasi: Pantau. Peningkatan suhu tubuh di atas normal akibat respon sitokin pirogen (indikasi antipiretik).</rdfs:comment>
        <rdfs:label xml:lang="id">Demam / suhu tubuh meningkat</rdfs:label>
        <rdfs:label>fever</rdfs:label>
        <rdfs:label xml:lang="en">fever</rdfs:label>
        <skos:altLabel xml:lang="id">Demam / suhu tubuh meningkat</skos:altLabel>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000613"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A neurological and physiological symptom that is characterized by a rise of body temperature above the normal, whether as a natural response (as to infection) or artificially induced for therapeutic reasons.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=fever</oboInOwl:hasDbXref>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SYMP_0000614">
        <obo:IAO_0000115>A respiratory system and chest symptom that is characterized by an explosive expulsion of air from the lungs acting as a protective mechanism to clear the air passages or as a symptom of pulmonary disturbance.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD9CM_2005:786.2</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0010200</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_ICD9CM_2005_AUI:A0043303</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0000614</oboInOwl:id>
        <rdfs:comment xml:lang="id">[GejalaIndikasi] Rekomendasi: Pantau. Refleks pertahanan saluran napas untuk membersihkan sekret atau iritan.</rdfs:comment>
        <rdfs:label xml:lang="id">Batuk</rdfs:label>
        <rdfs:label>cough</rdfs:label>
        <rdfs:label xml:lang="en">cough</rdfs:label>
        <skos:altLabel xml:lang="id">Batuk</skos:altLabel>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000614"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A respiratory system and chest symptom that is characterized by an explosive expulsion of air from the lungs acting as a protective mechanism to clear the air passages or as a symptom of pulmonary disturbance.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=cough</oboInOwl:hasDbXref>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SYMP_0000869">
        <obo:IAO_0000115>A congestion that is characterized by a blockage of the nasal passages, usually due to the membranes lining the nose becoming swollen from inflamed blood vessels.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0000869</oboInOwl:id>
        <rdfs:comment xml:lang="id">[GejalaIndikasi] Rekomendasi: Pantau. Penyumbatan rongga hidung akibat pembengkakan mukosa vaskular (indikasi dekongestan).</rdfs:comment>
        <rdfs:label xml:lang="id">Hidung tersumbat</rdfs:label>
        <rdfs:label>nasal congestion</rdfs:label>
        <rdfs:label xml:lang="en">nasal congestion</rdfs:label>
        <skos:altLabel xml:lang="id">Hidung tersumbat</skos:altLabel>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000869"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A congestion that is characterized by a blockage of the nasal passages, usually due to the membranes lining the nose becoming swollen from inflamed blood vessels.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:http://en.wikipedia.org/wiki/Nasal_congestion</oboInOwl:hasDbXref>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SYMP_0019145">
        <obo:IAO_0000115>Vomiting is a digestive system symptom characterized by throwing up the stomach contents.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>emesis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0019145</oboInOwl:id>
        <rdfs:comment xml:lang="id">[GejalaEfekSamping] Rekomendasi: TanyaApoteker. Pengeluaran isi lambung paksa; bila berulang hentikan konsumsi obat dan konsultasi apoteker.</rdfs:comment>
        <rdfs:label xml:lang="id">Muntah</rdfs:label>
        <rdfs:label>vomiting</rdfs:label>
        <rdfs:label xml:lang="en">vomiting</rdfs:label>
        <skos:altLabel xml:lang="id">Muntah</skos:altLabel>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0019145"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Vomiting is a digestive system symptom characterized by throwing up the stomach contents.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:http://www.merriam-webster.com/dictionary/vomiting</oboInOwl:hasDbXref>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SYMP_0019153">
        <obo:IAO_0000115>A respiratory abnormality that is characterized by difficult or labored respiration.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>breathing difficulty</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>breathlessness</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>difficulty breathing</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>labored respiration</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>shortness of breath</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0019153</oboInOwl:id>
        <rdfs:comment xml:lang="id">[GejalaRedFlag] Rekomendasi: SegeraKeDokter. Tanda bahaya gawat darurat infeksi saluran napas bawah (pneumonia/asma berat); rujuk segera.</rdfs:comment>
        <rdfs:label xml:lang="id">Sesak napas / kesulitan bernapas</rdfs:label>
        <rdfs:label>dyspnea</rdfs:label>
        <rdfs:label xml:lang="en">dyspnea</rdfs:label>
        <skos:altLabel xml:lang="id">Sesak napas / kesulitan bernapas</skos:altLabel>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0019153"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A respiratory abnormality that is characterized by difficult or labored respiration.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=dyspnea</oboInOwl:hasDbXref>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SYMP_0020027">
        <obo:IAO_0000115>A cough that is characterized by a production and expectoration (bringing up) of mucus (phlegm) or sputum.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>productive cough</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0020027</oboInOwl:id>
        <rdfs:comment xml:lang="id">[GejalaIndikasi] Rekomendasi: Pantau. Batuk disertai dahak kental pada saluran napas (indikasi ekspektoran/mukolitik).</rdfs:comment>
        <rdfs:label xml:lang="id">Batuk berdahak / produktif</rdfs:label>
        <rdfs:label>wet cough</rdfs:label>
        <rdfs:label xml:lang="en">wet cough</rdfs:label>
        <skos:altLabel xml:lang="id">Batuk berdahak / produktif</skos:altLabel>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0020027"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A cough that is characterized by a production and expectoration (bringing up) of mucus (phlegm) or sputum.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://www.webmd.com/lung/productive-cough-causes</oboInOwl:hasDbXref>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SYMP_0020043">
        <obo:IAO_0000115>A urinary system symptom that is characterized by an elevation in the concentration of the the pigments from foods, dyes, and medications in urine. The dilution of these pigment is dependent on the amount of water intake and severe dehydration can lead to a dark color.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0020043</oboInOwl:id>
        <rdfs:comment xml:lang="id">[GejalaRedFlag] Rekomendasi: SegeraKeDokter. Tanda toksisitas mioglobinuria/rhabdomyolysis atau hepatotoksisitas berat akibat interaksi obat.</rdfs:comment>
        <rdfs:label xml:lang="id">Urin berwarna gelap pekat seperti teh</rdfs:label>
        <rdfs:label>dark urine</rdfs:label>
        <rdfs:label xml:lang="en">dark urine</rdfs:label>
        <skos:altLabel xml:lang="id">Urin berwarna gelap pekat seperti teh</skos:altLabel>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0020043"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A urinary system symptom that is characterized by an elevation in the concentration of the the pigments from foods, dyes, and medications in urine. The dilution of these pigment is dependent on the amount of water intake and severe dehydration can lead to a dark color.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://www.mayoclinic.org/diseases-conditions/urine-color/symptoms-causes/syc-20367333</oboInOwl:hasDbXref>
    </owl:Axiom>
