<?xml version="1.0"?>
<rdf:RDF xmlns="http://purl.obolibrary.org/obo/kbr-group4/dinto_modul.owl#"
     xml:base="http://purl.obolibrary.org/obo/kbr-group4/dinto_modul.owl"
     xmlns:obo="http://purl.obolibrary.org/obo/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:obo1="http://purl.obolibrary.org/obo#"
     xmlns:purl="http://purl.obolibrary.org#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="http://purl.obolibrary.org/obo/kbr-group4/dinto_modul.owl">
        <owl:versionIRI rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/dinto_modul.owl/1.2"/>
        <rdfs:comment>MIREOT extract of drug interaction mechanisms and formal DDI relations from DINTO (Drug-Drug Interactions Ontology).</rdfs:comment>
    </owl:Ontology>
    


