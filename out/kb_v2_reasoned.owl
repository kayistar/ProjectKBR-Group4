    <!-- http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#atc4_R05CB -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#atc4_R05CB">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#KelasTerapiATC4"/>
        <kbr:kodeATC4>R05CB</kbr:kodeATC4>
        <rdfs:label xml:lang="en">Mucolytics</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#atc4_R05DA -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#atc4_R05DA">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#KelasTerapiATC4"/>
        <kbr:kodeATC4>R05DA</kbr:kodeATC4>
        <rdfs:label xml:lang="en">Opium alkaloids and derivatives</rdfs:label>
    </owl:NamedIndividual>
    


