    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#atc4_R05CA">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/kbr-group4/kb_v1.owl#KelasTerapiATC4"/>
        <kbr:kodeATC4>R05CA</kbr:kodeATC4>
