        <oboInOwl:hasRelatedSynonym>beta</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>beta(-)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>beta-particle</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>e</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>e(-)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>e-</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>electron</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>negatron</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>CHEBI:10545</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/chebi/3_STAR"/>
        <rdfs:label>electron</rdfs:label>
        <chemrof:charge rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-1</chemrof:charge>
        <chemrof:mass rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.001</chemrof:mass>
        <chemrof:monoisotopic_mass rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.0</chemrof:monoisotopic_mass>
    </owl:Class>
